{
  "function": {
    "prefix": "function",
    "body": ["function ${1:name}(${2:a:int}):${3:void}", "{", "\t$0", "}"],
    "description": "関数"
  },
  "public function": {
    "prefix": "pfunction",
    "body": ["public function ${1:name}(${2:a:int}):${3:void}", "{", "\t$0", "}"],
    "description": "公開関数"
  },
  "for": {
    "prefix": "for",
    "body": ["for (var ${1:i} = 0; $1 < ${2:n}; $1++) {", "\t$0", "}"],
    "description": "C 型 for (v2)"
  },
  "while": {
    "prefix": "while",
    "body": ["while (${1:cond}) {", "\t$0", "}"]
  },
  "loop": {
    "prefix": "loop",
    "body": ["loop {", "\t$0", "}"],
    "description": "無限ループ (v2)"
  },
  "if": {
    "prefix": "if",
    "body": ["if (${1:cond}) {", "\t$0", "}"]
  },
  "switch": {
    "prefix": "switch",
    "body": ["switch (${1:x}) {", "case ${2:0}:", "\t$0", "\tbreak;", "default:", "\tbreak;", "}"]
  },
  "struct": {
    "prefix": "struct",
    "body": ["struct ${1:Name} {", "\t${2:x}:${3:int};", "}"],
    "description": "struct (v2)"
  },
  "soa": {
    "prefix": "soa",
    "body": ["soa ${1:Name}:[${2:8}]${3:Struct};"],
    "description": "SoA コンテナ (v2)"
  },
  "use": {
    "prefix": "use",
    "body": ["use ${1:module};"]
  },
  "use from": {
    "prefix": "usefrom",
    "body": ["use * from ${1:module};"]
  },
  "fastcall": {
    "prefix": "fastcall",
    "body": ["function ${1:name}(${2:a:uint8}):${3:uint8} options(fastcall: true, symbol: \"${4:asm_symbol}\");"],
    "description": "外部 asm 用の legacy fastcall 宣言（FC 関数の本体には効果なし）"
  },
  "inline function": {
    "prefix": "inline",
    "body": ["function ${1:name}(${2:a:uint8}):${3:void} options(inline: true)", "{", "\t$0", "}"],
    "description": "インライン関数"
  },
  "function with default argument": {
    "prefix": "functiondefault",
    "body": ["function ${1:name}(${2:count}:${3:uint8} = ${4:1}):${5:void}", "{", "\t$0", "}"],
    "description": "定数式のデフォルト引数（末尾の引数に指定）"
  },
  "storage alias": {
    "prefix": "alias",
    "body": ["alias ${1:work}:${2:Work} = ${3:shared.memory};"],
    "description": "グローバル領域への型付き別名（追加の RAM 確保なし）"
  },
  "public storage alias": {
    "prefix": "palias",
    "body": ["public alias ${1:work}:${2:Work} = ${3:shared.memory};"],
    "description": "公開する型付き領域別名"
  },
  "BSS placement block": {
    "prefix": "bssblock",
    "body": ["block {", "\tvar ${1:work}:${2:uint8};", "\t$0", "} options(bss: \"${3:BSS_EX}\");"],
    "description": "グローバル変数の BSS 配置ブロック"
  },
  "module BSS": {
    "prefix": "bss",
    "body": ["options(bss: \"${1:BSS_EX}\");"],
    "description": "モジュールの既定 BSS セグメント"
  },
  "far function pointer": {
    "prefix": "farfn",
    "body": ["var ${1:handler}:farfn(${2:uint8}):${3:void};"],
    "description": "バンクを保持する関数ポインタ（farcall の設定が必要）"
  }
}
