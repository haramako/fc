#fc 4
// 縦シューティング (games/ のデバッグ用のゲーム)。十字キーで動き、A で撃つ。敵・敵の弾・爆発は soa の interface のタスクで、
// ID ごとの update / draw を呼び分ける。スプライトは 8×16 のモード (16×16 は 2 枚、8×8 の絵は下が空白の 8×16)。
// 3 回当たると GAME OVER (START でやり直し)。
//   fcc build -o shooter.nes main.fc
@(static_ram: 64);
use nes;
use frame;
use vram;
use pal;
use oam;
use pad;
use rand;
use math;
use hit;
use tiles;
use gfx;

const AUTO = false @(build);   // 一番下の敵の下へ動いて撃ち続ける (テストと見本)

var ticks:u16;            // メインループを回った数

const PALETTE = [
	0x0f, 0x00, 0x10, 0x30,  0x0f, 0x00, 0x10, 0x30,  0x0f, 0x00, 0x10, 0x30,  0x0f, 0x00, 0x10, 0x30,
	0x0f, 0x0f, 0x12, 0x30,  0x0f, 0x0f, 0x14, 0x34,  0x0f, 0x0f, 0x27, 0x30,  0x0f, 0x0f, 0x16, 0x38,   // 自機, 敵, おばけ・爆発, 弾
];

const SHOTS = 3;
const PLAYER_Y = 200;

// ---- タスク (敵・敵の弾・爆発) ----

soa interface Task {
	x:u8;
	y:u8;
	t:u8;                 // 生まれてからのフレーム
	function update(self:*Task):bool;     // false なら消える
	function draw(self:*Task):void;
	function solid(self:*Task):bool       // 自分の弾が当たる
	{
		return true;
	}
	function harm(self:*Task):bool        // 自分に当たると痛い
	{
		return true;
	}
	function points(self:*Task):u8
	{
		return 10;
	}
}

const TASKS = 16;
soa Tasks:[TASKS]Task;

// 波打って降りてくる
struct Bat: Task {
	cx:u8;                // 揺れの真ん中
}

function Bat.update(self:*Bat):bool
{
	self.t += 1;
	self.y += 1;
	self.x = self.cx +% (math.sin(self.t << 2) >> 3);
	return self.y < 232;
}

function Bat.draw(self:*Bat):void
{
	gfx.spr16_tall(self.x, self.y - 1, tiles.BAT0 + ((self.t >> 3) & 1) * 4, 1);
}

// 自機の x へ寄ってくる
struct Ghost: Task {
}

function Ghost.update(self:*Ghost):bool
{
	self.t += 1;
	if ((self.t & 1) == 0) {
		self.y += 1;
		if (self.x < px) {
			self.x += 1;
		} else if (self.x > px) {
			self.x -= 1;
		}
	}
	return self.y < 232;
}

function Ghost.draw(self:*Ghost):void
{
	gfx.spr16_tall(self.x, self.y - 1, tiles.GHOST0 + ((self.t >> 4) & 1) * 4, 2);
}

function Ghost.points(self:*Ghost):u8
{
	return 30;
}

// 横に往復して、ときどき自機を狙って撃つ
struct Ufo: Task {
	vx:i8;
}

function Ufo.update(self:*Ufo):bool
{
	self.t += 1;
	self.x = self.x +% self.vx;
	if (self.x < 8 || self.x > 232) {
		self.vx = -self.vx;
	}
	if ((self.t & 63) == 32) {
		fire_at(self.x + 4, self.y + 8);
	}
	return self.t < 240;
}

function Ufo.draw(self:*Ufo):void
{
	gfx.spr16_tall(self.x, self.y - 1, tiles.UFO, 1);
}

function Ufo.points(self:*Ufo):u8
{
	return 50;
}

// 敵の弾 (1/64 ピクセルの位置と速さ)
struct Bullet: Task {
	fx:u16;
	fy:u16;
	vx:i8;
	vy:i8;
}

function Bullet.update(self:*Bullet):bool
{
	self.fx = self.fx +% self.vx;
	self.fy = self.fy +% self.vy;
	self.x = (self.fx >> 6) as u8;
	self.y = (self.fy >> 6) as u8;
	return self.y < 236 && self.x > 2 && self.x < 250;
}

function Bullet.draw(self:*Bullet):void
{
	oam.spr(self.x, self.y - 1, tiles.BULLET_T16, 3);
}

function Bullet.solid(self:*Bullet):bool
{
	return false;
}

// 爆発 (24 フレーム)
struct Boom: Task {
}

function Boom.update(self:*Boom):bool
{
	self.t += 1;
	return self.t < 24;
}

function Boom.draw(self:*Boom):void
{
	gfx.spr16_tall(self.x, self.y - 1, tiles.BOOM0 + (self.t >> 3) * 4, 2);
}

function Boom.solid(self:*Boom):bool
{
	return false;
}

function Boom.harm(self:*Boom):bool
{
	return false;
}

// ---- 自機 ----

struct Shot {
	x:u8;
	y:u8;
	live:bool;
}

var px:u8;
var lives:u8;
var invincible:u8;        // 当たった後の無敵のフレーム
var shots:[SHOTS]Shot;
var score:u16;
var kills:u16;
var games:u8;
var line:[32]u8;

// 空いているタスクの添字 (無ければ 255)
function free_task():u8
{
	for (var i:u8 = 0; i < TASKS; i += 1) {
		if (@id_of(&Tasks[i]) == .none) {
			return i;
		}
	}
	return 255;
}

// (x, y) から自機を狙う弾
function fire_at(x:u8, y:u8):void
{
	var i = free_task();
	if (i == 255) {
		return;
	}
	var a = math.angle_to(x, y, px + 8, PLAYER_Y + 8);
	Tasks[i] = Bullet{x: x, y: y, t: 0, fx: x as u16 << 6, fy: y as u16 << 6, vx: math.cos(a), vy: math.sin(a)};
}

function spawn_enemy():void
{
	var i = free_task();
	if (i == 255) {
		return;
	}
	var x = 16 + rand.below(208);
	switch (rand.below(4)) {
	case 0, 1:
		Tasks[i] = Bat{x: x, y: 0, t: rand.next_u8(), cx: x};
	case 2:
		Tasks[i] = Ghost{x: x, y: 0, t: 0};
	default:
		Tasks[i] = Ufo{x: x, y: 24, t: 0, vx: rand.chance(128) ? 1 : -1};
	}
}

function hud():void
{
	vram.put(vram.addr(0, 2, 1), @format(line, "SCORE {:5}   SHIPS {}", score, lives));
}

function new_game():void
{
	for (var i:u8 = 0; i < TASKS; i += 1) {
		@set_id(&Tasks[i], .none);
	}
	for (var i:u8 = 0; i < SHOTS; i += 1) {
		shots[i].live = false;
	}
	px = 120;
	lives = 3;
	invincible = 60;
	score = 0;
	hud();
}

function stars():void
{
	for (var i:u8 = 0; i < 60; i += 1) {
		var t = rand.chance(64) ? tiles.POWER : tiles.DOT;
		vram.set(vram.addr(0, rand.below(32), 3 + rand.below(27)), t);
	}
}

function fire():void
{
	for (var i:u8 = 0; i < SHOTS; i += 1) {
		if (!shots[i].live) {
			shots[i] = {px + 4, PLAYER_Y - 12, true};
			return;
		}
	}
}

function move_player():void
{
	var b = pad.p1.held;
	var fire_now = (pad.p1.pressed & pad.A) != 0;
	if (AUTO) {
		// 一番下にいる、弾の当たる敵の下へ
		var target = px;
		var lowest:u8 = 0;
		for (var i:u8 = 0; i < TASKS; i += 1) {
			var e = &Tasks[i];
			if (@id_of(e) != .none && e.solid() && e.y >= lowest) {
				lowest = e.y;
				target = e.x;
			}
		}
		b = target < px ? pad.LEFT : target > px + 1 ? pad.RIGHT : 0;
		fire_now = (ticks & 7) == 0;
	}
	if ((b & pad.LEFT) != 0 && px > 8) {
		px -= 2;
	}
	if ((b & pad.RIGHT) != 0 && px < 232) {
		px += 2;
	}
	if (fire_now) {
		fire();
	}
}

// 弾を進めて、当たった敵を爆発にする
function move_shots():void
{
	for (var s:u8 = 0; s < SHOTS; s += 1) {
		if (!shots[s].live) {
			continue;
		}
		if (shots[s].y < 8) {
			shots[s].live = false;
			continue;
		}
		shots[s].y -= 6;
		for (var i:u8 = 0; i < TASKS; i += 1) {
			var e = &Tasks[i];
			if (@id_of(e) == .none || !e.solid()) {
				continue;
			}
			if (hit.box(e.x, e.y, 16, 16, shots[s].x, shots[s].y, 8, 12)) {
				score += e.points() as u16;
				kills += 1;
				Tasks[i] = Boom{x: e.x, y: e.y, t: 0};
				shots[s].live = false;
				hud();
				break;
			}
		}
	}
}

function update_tasks():void
{
	for (var i:u8 = 0; i < TASKS; i += 1) {
		var e = &Tasks[i];
		if (@id_of(e) == .none) {
			continue;
		}
		if (!e.update()) {
			@set_id(e, .none);
			continue;
		}
		if (invincible == 0 && e.harm() && hit.box(e.x + 3, e.y + 3, 10, 10, px + 3, PLAYER_Y + 3, 10, 10)) {
			invincible = 90;
			lives -= 1;
			Tasks[i] = Boom{x: px, y: PLAYER_Y, t: 0};
			hud();
		}
	}
}

function draw():void
{
	oam.begin();
	if (invincible == 0 || (invincible & 4) == 0) {
		gfx.spr16_tall(px, PLAYER_Y - 1, tiles.SHIP, 0);
	}
	for (var s:u8 = 0; s < SHOTS; s += 1) {
		if (shots[s].live) {
			oam.spr(shots[s].x, shots[s].y - 1, tiles.SHOT_T16, 0);
		}
	}
	for (var i:u8 = 0; i < TASKS; i += 1) {
		var e = &Tasks[i];
		if (@id_of(e) != .none) {
			e.draw();
		}
	}
	oam.end();
}

// メインループの 1 回の終わり: 手数を数えてフレームを待つ (テストは手数 ticks の決まった所で -O 0 と -O 2 の状態を比べる)
function end_frame():void @(noinline)
{
	ticks += 1;
	frame.wait();
}

function main():void
{
	frame.init();
	frame.ctrl |= nes.CTRL_SPR_8X16;
	pal.set_all(PALETTE);
	rand.seed(0x5407);
	stars();
	new_game();
	frame.render_on();
	while (true) {
		pad.poll();
		move_player();
		move_shots();
		update_tasks();
		if (invincible > 0) {
			invincible -= 1;
		}
		if ((ticks & 31) == 0) {
			spawn_enemy();
		}
		if ((ticks & 15) == 0) {
			pal.set(1, (ticks & 16) != 0 ? 0x00 : 0x10);   // 星がまたたく
		}
		if (lives == 0) {
			games += 1;
			vram.put(vram.addr(0, 11, 14), "GAME OVER");
			draw();
			end_frame();
			if (!AUTO) {
				while ((pad.p1.pressed & pad.START) == 0) {
					pad.poll();
					frame.wait();
				}
			}
			vram.put(vram.addr(0, 11, 14), "         ");
			new_game();
		}
		draw();
		end_frame();
	}
}
