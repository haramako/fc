#fc 4
// テキストアドベンチャー (games/ のデバッグ用のゲーム。英語)。画面の下のキーボードで命令を打つ (十字キーで選び、A で打つ、B で 1 文字
// 消す、START で決める)。命令は「動詞 [名前]」: LOOK, N / S / E / W / U / D, GO <向き>, TAKE / GET <物>, DROP <物>, INV, OPEN <物>,
// HELP。宝石をホールに置くと勝ち。出力は文字の窓 (games/common/text.fc。単語で折り返し、下まで行ったら上へずらす)。
//   fcc build -o adventure.nes main.fc
@(static_ram: 128);   // 静的フレームの RAM の予約 (既定の 512 では文字の窓の写しと合わせて RAM に入らない。使うのは 71 バイト)
use nes;
use frame;
use vram;
use pal;
use oam;
use pad;
use str;
use tiles;
use text;

const AUTO = false @(build);   // 決まった命令を打って解く (テストと見本)

var ticks:u16;            // メインループを回った数

const PALETTE = [
	0x0f, 0x00, 0x10, 0x30,  0x0f, 0x00, 0x28, 0x38,  0x0f, 0x00, 0x10, 0x30,  0x0f, 0x00, 0x10, 0x30,
	0x0f, 0x0f, 0x28, 0x38,  0x0f, 0x0f, 0x16, 0x30,  0x0f, 0x0f, 0x16, 0x30,  0x0f, 0x0f, 0x16, 0x30,
];

// ---- 世界 ----

enum Room:u8 {
	Hall,
	Library,
	Cellar,
	Study,
	Nowhere,
}

const ROOM_NAMES = ["HALL", "LIBRARY", "CELLAR", "STUDY"];
const ROOM_TEXT = [
	"A dusty hall. A door leads north and stairs go down into the dark.",
	"Old books line the walls. A heavy door stands to the east.",
	"A damp cellar. Water drips from the ceiling.",
	"A quiet study. A wooden chest sits under the window.",
];
// 出口 [部屋][N S E W U D] (Nowhere は無し)
const EXITS:[4][6]Room = [
	[.Library, .Nowhere, .Nowhere, .Nowhere, .Nowhere, .Cellar],
	[.Nowhere, .Hall, .Study, .Nowhere, .Nowhere, .Nowhere],
	[.Nowhere, .Nowhere, .Nowhere, .Nowhere, .Hall, .Nowhere],
	[.Nowhere, .Nowhere, .Nowhere, .Library, .Nowhere, .Nowhere],
];
const DIRS = ["N", "S", "E", "W", "U", "D"];
const DIR_WORDS = ["NORTH", "SOUTH", "EAST", "WEST", "UP", "DOWN"];

const ITEMS = ["LAMP", "KEY", "GEM"];
const ITEM_TEXT = ["a brass lamp", "a small key", "a shining gem"];
const CARRIED = 0xfe;     // 持っている物の場所
const HIDDEN = 0xff;      // まだ出てこない物の場所

var item_at:[3]u8;        // 物の場所 (部屋の番号か CARRIED / HIDDEN)
var room:Room;
var door_open:bool;
var chest_open:bool;
var won:bool;
var moves:u8;

// ---- 打つ所 ----

const KEYS = 29;          // A〜Z, SPACE, DEL, ENTER
const KX = [3, 11, 17];   // 下の行の SPACE / DEL / ENTER の x
var cmd:[24]u8;
var cmd_len:u8;
var cursor:u8;            // キーボードの選んでいるキー
var line:[40]u8;

function key_pos(k:u8, x:*u8, y:*u8):void
{
	if (k < 26) {
		*x = 3 + (k % 13) * 2;
		*y = 24 + k / 13;
	} else {
		*x = KX[k - 26];
		*y = 26;
	}
}

function draw_keyboard():void
{
	var row:[26]u8;
	for (var r:u8 = 0; r < 2; r += 1) {
		for (var i:u8 = 0; i < 13; i += 1) {
			row[i * 2] = 'A' + r * 13 + i;
			row[i * 2 + 1] = ' ';
		}
		vram.put(vram.addr(0, 3, 24 + r), row);
	}
	vram.put(vram.addr(0, 3, 26), "SPACE   DEL   ENTER");
}

// 打っている命令 (書式には文字列の幅が無いので、残りは空白で埋める)
function draw_cmd():void
{
	var a = vram.addr(0, 1, 21);
	vram.put(a, "> ");
	vram.put(a + 2, cmd[..cmd_len]);
	vram.set(a + 2 + cmd_len, '_');
	vram.fill(a + 3 + cmd_len, ' ', @len(cmd) - cmd_len);
}

// ---- 物と部屋 ----

function item_here(i:u8):bool
{
	return item_at[i] == room as u8;
}

function lit():bool
{
	return room != .Cellar || item_at[0] == CARRIED;
}

function describe():void
{
	text.println(@format(line, "[{}]", ROOM_NAMES[room as u8]));
	if (!lit()) {
		text.println("It is too dark to see.");
		return;
	}
	text.println(ROOM_TEXT[room as u8]);
	if (room == .Library && door_open) {
		text.println("The east door is open.");
	}
	for (var i:u8 = 0; i < @len(ITEMS); i += 1) {
		if (item_here(i)) {
			text.print("You see ");
			text.print(ITEM_TEXT[i]);
			text.println(".");
		}
	}
}

function find_item(word:[]const u8):u8
{
	for (var i:u8 = 0; i < @len(ITEMS); i += 1) {
		if (str.equal(word, ITEMS[i])) {
			return i;
		}
	}
	return 255;
}

function go(d:u8):void
{
	var to = EXITS[room as u8][d];
	if (to == .Nowhere) {
		text.println("You can't go that way.");
		return;
	}
	if (room == .Library && to == .Study && !door_open) {
		text.println("The door is locked.");
		return;
	}
	room = to;
	describe();
}

function take(word:[]const u8):void
{
	var i = find_item(word);
	if (i == 255 || !item_here(i) || !lit()) {
		text.println("You don't see that here.");
		return;
	}
	item_at[i] = CARRIED;
	text.println("Taken.");
}

function drop(word:[]const u8):void
{
	var i = find_item(word);
	if (i == 255 || item_at[i] != CARRIED) {
		text.println("You don't have that.");
		return;
	}
	item_at[i] = room as u8;
	text.println("Dropped.");
	if (i == 2 && room == .Hall) {
		won = true;
		text.println(@format(line, "*** YOU WIN IN {} MOVES ***", moves));
	}
}

function open_thing(word:[]const u8):void
{
	if (str.equal(word, "DOOR") && room == .Library) {
		if (item_at[1] != CARRIED) {
			text.println("It is locked. You need a key.");
		} else if (!door_open) {
			door_open = true;
			text.println("The key turns. The door opens.");
		} else {
			text.println("It is already open.");
		}
		return;
	}
	if (str.equal(word, "CHEST") && room == .Study) {
		if (!chest_open) {
			chest_open = true;
			item_at[2] = room as u8;
			text.println("Inside the chest you find a gem!");
		} else {
			text.println("The chest is empty.");
		}
		return;
	}
	text.println("You can't open that.");
}

function inventory():void
{
	var any = false;
	text.print("You carry:");
	for (var i:u8 = 0; i < @len(ITEMS); i += 1) {
		if (item_at[i] == CARRIED) {
			text.print(" ");
			text.print(ITEMS[i]);
			any = true;
		}
	}
	text.println(any ? "." : " nothing.");
}

// 命令を単語に分けて実行する
function run(input:[]const u8):void
{
	var words:[3][]const u8;
	var n:u8 = 0;
	var i:u8 = 0;
	var len = @len(input);
	while (i < len && n < 3) {
		while (i < len && input[i] == ' ') {
			i += 1;
		}
		var start = i;
		while (i < len && input[i] != ' ') {
			i += 1;
		}
		if (i > start) {
			words[n] = input[start..i];
			n += 1;
		}
	}
	if (n == 0) {
		return;
	}
	text.println(@format(line, "> {}", input));
	moves += 1;
	var verb = words[0];
	var obj:[]const u8 = n > 1 ? words[1] : "";
	if (str.equal(verb, "GO") && n > 1) {
		verb = obj;
	}
	for (var d:u8 = 0; d < 6; d += 1) {
		if (str.equal(verb, DIRS[d]) || str.equal(verb, DIR_WORDS[d])) {
			go(d);
			return;
		}
	}
	if (str.equal(verb, "LOOK") || str.equal(verb, "L")) {
		describe();
	} else if (str.equal(verb, "TAKE") || str.equal(verb, "GET")) {
		take(obj);
	} else if (str.equal(verb, "DROP")) {
		drop(obj);
	} else if (str.equal(verb, "INV") || str.equal(verb, "I")) {
		inventory();
	} else if (str.equal(verb, "OPEN") || str.equal(verb, "UNLOCK")) {
		open_thing(obj);
	} else if (str.equal(verb, "HELP")) {
		text.println("Try LOOK, N S E W U D, TAKE, DROP, OPEN, INV.");
	} else {
		text.println("I don't understand.");
	}
}

function new_game():void
{
	item_at = [0, 2, HIDDEN];   // ランプはホール、鍵は地下室、宝石は箱の中
	room = .Hall;
	door_open = false;
	chest_open = false;
	won = false;
	moves = 0;
	cmd_len = 0;
	text.clear();
	text.println("FC ADVENTURE");
	text.println("Find the gem and bring it back to the hall. Type HELP for help.");
	text.newline();
	describe();
	draw_cmd();
}

// ---- 入力 ----

function press(k:u8):void
{
	if (k < 26) {
		if (cmd_len < @len(cmd)) {
			cmd[cmd_len] = 'A' + k;
			cmd_len += 1;
		}
	} else if (k == 26) {
		if (cmd_len < @len(cmd)) {
			cmd[cmd_len] = ' ';
			cmd_len += 1;
		}
	} else if (k == 27) {
		if (cmd_len > 0) {
			cmd_len -= 1;
		}
	} else {
		run(cmd[..cmd_len]);
		cmd_len = 0;
	}
	draw_cmd();
}

function input():void
{
	var r = pad.p1.repeat;
	if ((r & pad.LEFT) != 0) {
		cursor = cursor == 0 ? KEYS - 1 : cursor - 1;
	}
	if ((r & pad.RIGHT) != 0) {
		cursor = cursor == KEYS - 1 ? 0 : cursor + 1;
	}
	if ((r & pad.DOWN) != 0) {
		cursor = cursor < 13 ? cursor + 13 : cursor < 26 ? 26 + @min((cursor - 13) / 5, 2) : cursor % 13;
	}
	if ((r & pad.UP) != 0) {
		cursor = cursor >= 26 ? 13 + (cursor - 26) * 5 : cursor >= 13 ? cursor - 13 : cursor;
	}
	var p = pad.p1.pressed;
	if ((p & pad.A) != 0) {
		press(cursor);
	} else if ((p & pad.B) != 0) {
		press(27);
	} else if ((p & pad.START) != 0) {
		press(28);
	}
}

// AUTO: 命令を 1 文字ずつキーボードで打つ (キーの番号に直して press)
const SCRIPT = [
	"LOOK", "DANCE", "TAKE LAMP", "GO DOWN", "TAKE KEY", "U", "N", "OPEN DOOR", "E", "OPEN CHEST",
	"TAKE GEM", "INV", "W", "S", "DROP GEM",
];
var script_i:u8;
var char_i:u8;

function auto_type():void
{
	if ((ticks & 3) != 0) {
		return;
	}
	if (script_i >= @len(SCRIPT)) {
		if (won) {
			script_i = 0;   // もう一度最初から
			new_game();
		}
		return;
	}
	var s = SCRIPT[script_i];
	if (char_i < @len(s)) {
		var c = s[char_i];
		cursor = c == ' ' ? 26 : c - 'A';
		char_i += 1;
	} else {
		cursor = 28;
		char_i = 0;
		script_i += 1;
	}
	press(cursor);
}

// メインループの 1 回の終わり: 手数を数えてフレームを待つ (テストは手数 ticks の決まった所で -O 0 と -O 2 の状態を比べる)
function end_frame():void @(noinline)
{
	ticks += 1;
	frame.wait();
}

var wins:u8;

function main():void
{
	frame.init();
	frame.ctrl |= nes.CTRL_SPR_1000;
	pal.set_all(PALETTE);
	vram.fill(vram.attr_addr(0, 0, 24), 0x55, 16);   // キーボードはパレット 1
	draw_keyboard();
	text.open(1, 2, 30, 16);
	new_game();
	frame.render_on();
	var was_won = false;
	while (true) {
		pad.poll();
		if (AUTO) {
			auto_type();
		} else {
			input();
		}
		if (won && !was_won) {
			wins += 1;
		}
		was_won = won;
		var x:u8 = 0;
		var y:u8 = 0;
		key_pos(cursor, &x, &y);
		oam.begin();
		oam.spr(x * 8 - 8, y * 8 - 1, tiles.ARROW, 0);
		oam.end();
		end_frame();
	}
}
