#fc 4
// 横スクロールのジャンプアクション (games/ のデバッグ用のゲーム)。十字キーで歩き、A で跳ぶ。? のブロックを下から叩くとコイン、
// スライムは上から踏むと倒せる。穴とトゲに気をつけてドアまで行くと面クリア (同じ面をもう一度)。
// 面は横 64 マス (16×16) で、画面の右に入る列をネームテーブル 0 / 1 (左右に並ぶ: 縦のミラー) へ 1 列ずつ書き足す。
// 上の文字の行は止めたまま、スプライト 0 の当たりから下だけ横にずらす。スライムは soa の struct のメソッド。
//   fcc build -o platform.nes main.fc
use nes;
use frame;
use vram;
use pal;
use oam;
use pad;
use tiles;
use gfx;

const AUTO = false @(build);   // 右へ歩き、壁・穴・トゲ・敵の手前で跳ぶ (テストと見本)

var ticks:u16;            // メインループを回った数

const PALETTE = [
	0x21, 0x07, 0x17, 0x27,  0x21, 0x09, 0x19, 0x29,  0x21, 0x00, 0x10, 0x30,  0x21, 0x00, 0x10, 0x30,
	0x21, 0x0f, 0x16, 0x37,  0x21, 0x0f, 0x1a, 0x30,  0x21, 0x0f, 0x28, 0x38,  0x21, 0x0f, 0x16, 0x30,   // 自分, スライム, コイン
];

// 面 (. 空, # 地面, B レンガ, ? ブロック, ^ トゲ, D ドア, T 木, C ) 雲の左右, e スライム, o コイン)
const LEVEL = [
	"................................................................",
	"................................................................",
	"......C)....................................C)..................",
	"........................C)......................................",
	"................................................................",
	"..................................o.o.o.........................",
	"................................................................",
	"........B?B.....?................BB?BB..?.........?.............",
	"...............................................o................",
	"......................o....#.........................#....o.....",
	"....T.........e...........##..e.....^.e....##....e..##........D.",
	"####################..########################..#########...####",
	"####################..########################..#########...####",
];
const LW = 64;            // 面の大きさ (マス)
const LH = 13;
const TOP = 2;            // 面の上の行 (マス。上の 2 マス = 4 タイルは文字)
const GRAVITY = 4;        // 1/16 ピクセル / フレーム²
const JUMP = -82;
const FALL_MAX = 64;
const SPEED = 24;         // 1/16 ピクセル / フレーム

// ---- スライム (soa の struct のメソッド) ----

struct Slime {
	x:u16;                // ピクセル (面の左から)
	y:u8;                 // ピクセル (面の上から)
	vx:i8;
	alive:bool;
}

soa Slimes:[6]Slime;

// 歩く。壁か足場の端で向きを変える
function Slimes.update(self:*Slimes):void
{
	if (!self.alive || (ticks & 1) != 0) {
		return;
	}
	var ahead = self.vx > 0 ? self.x + 16 : self.x - 1;
	var cx = (ahead >> 4) as u8;
	var cy = self.y >> 4;
	if (solid(cell(cx, cy)) || !solid(cell(cx, cy + 1))) {
		self.vx = -self.vx;
		return;
	}
	self.x = self.x +% self.vx;
}

function Slimes.draw(self:*Slimes):void
{
	if (!self.alive || self.x + 16 < cam || self.x >= cam + 256) {
		return;
	}
	gfx.spr16((self.x - cam) as u8, self.y + TOP * 16 - 1, tiles.SLIME0 + ((ticks >> 3) as u8 & 1) * 4, 1);
}

// ---- コイン ----

struct Coin {
	x:u16;
	y:u8;
	got:bool;
}

var coins_in:[8]Coin;     // 面に置いたコイン
var n_coins:u8;

// ---- 面 ----

var used:[8]u16;          // 叩いた ? (y * LW + x)
var n_used:u8;
var drawn:u8;             // 次に書く列
var cam:u16;              // 画面の左端 (面のピクセル)
var n_slimes:u8;

function cell(cx:u8, cy:u8):u8
{
	if (cy >= LH) {
		return '.';
	}
	if (cx >= LW) {
		return '#';
	}
	var c = LEVEL[cy][cx];
	if (c == '?') {
		var k = cy as u16 * LW + cx;
		for (var i:u8 = 0; i < n_used; i += 1) {
			if (used[i] == k) {
				return 'U';
			}
		}
	}
	return c;
}

function solid(c:u8):bool
{
	return c == '#' || c == 'B' || c == '?' || c == 'U';
}

// マスの 16×16 の絵 (0 は空)
function art(cx:u8, cy:u8):u8
{
	switch (cell(cx, cy)) {
	case '#':
		return cy > 0 && LEVEL[cy - 1][cx] == '#' ? tiles.DIRT : tiles.GRASS;
	case 'B':
		return tiles.BRICK;
	case '?':
		return tiles.QBLOCK;
	case 'U':
		return tiles.USED;
	case '^':
		return tiles.SPIKES;
	case 'D':
		return tiles.DOOR;
	case 'T':
		return tiles.TREE;
	case 'C':
		return tiles.CLOUD;
	case ')':
		return tiles.CLOUD + 2;
	}
	return 0;
}

// 面の列 cx を、ネームテーブル (cx / 16) % 2 に書く。スライムとコインもここで出す
function draw_column(cx:u8):void
{
	var left:[LH * 2]u8;
	var right:[LH * 2]u8;
	for (var cy:u8 = 0; cy < LH; cy += 1) {
		var n = art(cx, cy);
		var k = cy * 2;
		if (n == 0) {
			left[k] = 0;
			left[k + 1] = 0;
			right[k] = 0;
			right[k + 1] = 0;
		} else {
			left[k] = n;
			left[k + 1] = n + 16;
			right[k] = n + 1;
			right[k + 1] = n + 17;
		}
		var c = LEVEL[cy][cx];
		if (c == 'e' && n_slimes < 6) {
			Slimes[n_slimes] = {cx as u16 << 4, cy << 4, -1, true};
			n_slimes += 1;
		} else if (c == 'o' && n_coins < @len(coins_in)) {
			coins_in[n_coins] = {cx as u16 << 4, cy << 4, false};
			n_coins += 1;
		}
	}
	var nt = (cx >> 4) & 1;
	var x = (cx & 15) << 1;
	vram.put_v(vram.addr(nt, x, TOP * 2), left);
	vram.put_v(vram.addr(nt, x + 1, TOP * 2), right);
}

// ---- 自分 ----

var wx:u16;               // 自分の左 (面のピクセルの 1/16)
var wy:u16;               // 自分の上 (面のピクセルの 1/16)
var vy:i8;
var on_ground:bool;
var facing_left:bool;
var walking:bool;
var coins:u8;
var lives:u8;
var clears:u8;            // ドアに着いた数 (テスト用)
var deaths:u8;
var line:[32]u8;

function x():u16
{
	return wx >> 4;
}

function y():u8
{
	return (wy >> 4) as u8;
}

function hud():void
{
	vram.put(vram.addr(0, 2, 1), @format(line, "COINS {:2}   LIVES {}   CLEAR {}", coins, lives, clears));
}

// 面を最初から (描画を止めて、見える所の列を書く)
function start_level():void
{
	frame.render_off();
	n_used = 0;
	n_slimes = 0;
	n_coins = 0;
	for (var i:u8 = 0; i < 6; i += 1) {
		Slimes[i].alive = false;
	}
	for (drawn = 0; drawn < 17; drawn += 1) {
		draw_column(drawn);
	}
	cam = 0;
	wx = 2 * 16 << 4;
	wy = 10 * 16 << 4;
	vy = 0;
	on_ground = true;
	hud();
	frame.render_on();
}

function die():void
{
	deaths += 1;
	if (lives > 1) {
		lives -= 1;
	} else {
		lives = 3;
		coins = 0;
	}
	start_level();
}

// (px, py) のピクセルのマスが固いか
function solid_at(px:u16, py:u8):bool
{
	return solid(cell((px >> 4) as u8, py >> 4));
}

// AUTO: 跳ぶか (地面の上で、前に壁・穴・トゲ・スライムがある)
function want_jump():bool
{
	var front = ((x() + 20) >> 4) as u8;
	var feet = (y() + 15) >> 4;
	var c = cell(front, feet);
	if (solid(c) || c == '^' || solid(cell(front, feet - 1)) || !solid(cell(front, feet + 1)) || cell(front + 1, feet) == '^') {
		return true;
	}
	for (var i:u8 = 0; i < 6; i += 1) {
		var s = &Slimes[i];
		if (s.alive && s.x > x() && s.x < x() + 40 && s.y + 16 > y() && s.y < y() + 16) {
			return true;
		}
	}
	return false;
}

function move_player():void
{
	var held = pad.p1.held;
	var jump = (pad.p1.pressed & pad.A) != 0;
	if (AUTO) {
		held = pad.RIGHT;
		jump = on_ground && want_jump();
		if (!on_ground && vy < 0) {
			held |= pad.A;   // 上がる間は押し続ける
		}
	}
	// 横
	walking = false;
	var nx = wx;
	if ((held & pad.RIGHT) != 0) {
		nx = wx + SPEED;
		facing_left = false;
	} else if ((held & pad.LEFT) != 0 && wx >= (cam << 4) + SPEED) {
		nx = wx - SPEED;
		facing_left = true;
	}
	if (nx != wx) {
		var px = (nx >> 4) + (nx > wx ? 13 : 2);
		if (!solid_at(px, y() + 1) && !solid_at(px, y() + 14)) {
			wx = nx;
			walking = true;
		}
	}
	// 縦
	if (on_ground && jump) {
		vy = JUMP;
		on_ground = false;
	}
	if (!on_ground) {
		if (vy < 0 && (held & pad.A) == 0 && !jump) {
			vy /= 2;   // 早く離すと低く
		}
		vy = @min(vy + GRAVITY, FALL_MAX);
		wy = wy +% vy;
		if (wy >= 0x8000) {
			wy = 0;    // 面の上へ出た
		}
		var l = x() + 2;
		var r = x() + 13;
		if (vy > 0) {
			var feet = y() + 16;
			if (feet < LH * 16 && (solid_at(l, feet) || solid_at(r, feet))) {
				wy = ((feet & 0xf0) - 16) as u16 << 4;
				vy = 0;
				on_ground = true;
			}
		} else if (solid_at(l, y()) || solid_at(r, y())) {
			// 頭をぶつけた: ? ならコイン
			var hx = ((x() + 8) >> 4) as u8;
			var hy = y() >> 4;
			if (cell(hx, hy) == '?' && n_used < @len(used)) {
				used[n_used] = hy as u16 * LW + hx;
				n_used += 1;
				gfx.put16((hx >> 4) & 1, hx & 15, hy + TOP, tiles.USED);
				coins += 1;
				hud();
			}
			wy = ((hy + 1) as u16 << 4) << 4;
			vy = 0;
		}
	} else if (!solid_at(x() + 2, y() + 16) && !solid_at(x() + 13, y() + 16)) {
		on_ground = false;
		vy = 0;
	}
	// 穴・トゲ・ドア
	var c = cell(((x() + 8) >> 4) as u8, (y() + 8) >> 4);
	if (y() > LH * 16 || c == '^') {
		die();
	} else if (c == 'D') {
		clears += 1;
		start_level();
	}
}

function touch_enemies():void
{
	for (var i:u8 = 0; i < 6; i += 1) {
		var s = &Slimes[i];
		s.update();
		if (!s.alive || s.x + 12 < x() || s.x > x() + 12) {
			continue;
		}
		var dy = s.y as i16 - y() as i16;   // スライムが下なら正
		if (dy >= 16 || dy <= -14) {
			continue;
		}
		if (vy > 0 && dy > 4) {
			s.alive = false;  // 踏んだ
			vy = JUMP / 2;
		} else {
			die();
			return;
		}
	}
	for (var i:u8 = 0; i < n_coins; i += 1) {
		var k = &coins_in[i];
		if (!k.got && k.x + 8 > x() && k.x < x() + 14 && k.y + 16 > y() && k.y < y() + 16) {
			k.got = true;
			coins += 1;
			hud();
		}
	}
}

function update_camera():void
{
	if (x() > cam + 112) {
		cam = @min(x() - 112, (LW - 16) * 16);
	}
	if (drawn < LW && (drawn as u16) * 16 < cam + 256 + 16) {
		draw_column(drawn);
		drawn += 1;
	}
}

function draw():void
{
	oam.begin();
	var n = !on_ground ? tiles.HERO_RJ : walking && (ticks & 8) != 0 ? tiles.HERO_R1 : tiles.HERO_R0;
	gfx.spr16((x() - cam) as u8, y() + TOP * 16 - 1, n, facing_left ? nes.ATTR_FLIP_H : 0);
	for (var i:u8 = 0; i < 6; i += 1) {
		Slimes[i].draw();
	}
	for (var i:u8 = 0; i < n_coins; i += 1) {
		var k = &coins_in[i];
		if (!k.got && k.x + 8 > cam && k.x < cam + 256) {
			oam.meta((k.x - cam) as i16 + 4, (k.y + TOP * 16) as i16 - 1, (ticks & 16) != 0 ? tiles.COIN0_M8 : tiles.COIN1_M8, 0);
		}
	}
	oam.end();
}

// スプライト 0 の当たりを待ってから、下の部分を横にずらす (上の文字の行は NMI の scroll のまま)
function split():void
{
	if (!frame.rendering()) {
		return;   // 描画を止めている間は当たりが来ない
	}
	var n:u16 = 0;
	while ((nes.PPUSTATUS & nes.STATUS_SPR0) != 0 && n < 4000) {
		n += 1;
	}
	while ((nes.PPUSTATUS & nes.STATUS_SPR0) == 0 && n < 8000) {
		n += 1;
	}
	nes.PPUSCROLL = cam as u8;
	nes.PPUSCROLL = 0;
	nes.PPUCTRL = frame.ctrl | nes.CTRL_NMI | ((cam >> 8) as u8 & 1);
}

// メインループの 1 回の終わり: 手数を数えてフレームを待つ (テストは手数 ticks の決まった所で -O 0 と -O 2 の状態を比べる)
function end_frame():void @(noinline)
{
	ticks += 1;
	frame.wait();
}

function main():void
{
	frame.init();
	frame.ctrl |= nes.CTRL_SPR_1000;
	pal.set_all(PALETTE);
	vram.fill(vram.addr(0, 0, 3), tiles.FRAME_B, 32);   // 文字の行の下の線 (スプライト 0 がここに重なる)
	vram.fill(vram.attr_addr(0, 0, 0), 0xaa, 8);         // 文字の行 (上の 4 タイル) はパレット 2 (白)。面はパレット 0
	oam.reserve(1);
	oam.set(0, 248, 25, tiles.BULLET, nes.ATTR_BEHIND);
	lives = 3;
	start_level();
	while (true) {
		pad.poll();
		move_player();
		touch_enemies();
		update_camera();
		draw();
		end_frame();
		split();
	}
}
