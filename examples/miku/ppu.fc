#fc 3
use * from nes;

@(bank: -1);

@include("ppu.asm");

var vsync_flag:u8;
public var ctrl1_bak:u8; // = 0b10000000;
public var ctrl2_bak:u8; // = 0b00011110;
public var scroll1:u8;
public var scroll2:u8;

const HORIZONTAL = 0b00000000;
const VERTICAL = 0b01000000;
const ATTRIBUTE = 0b10000000;

const GR_MAX = 8;
var gr_idx:u8;
var gr_to_buf:[GR_MAX]u16;
var gr_from_buf:[GR_MAX]*u8;
var gr_size_buf:[GR_MAX]u8;
var gr_flag_buf:[GR_MAX]u8;
var gr_sprite_idx:u8;
var gr_sprite_buf:[256]u8 @(address: 0x0700);
var gr_buf:[256]u8;
var gr_buf_idx:u8;

var put_to:u16;
var put_from:*u8 @(address: 0x60);
var put_size:u8;
var interrupt_i:u8;

// IRQ関連
var irq_counter:u8;
var irq_setup:fn():void;   // 以前は ZP の固定番地 ($62) だったが、$00-$7F は fc の領域なので BSS に
var irq_next:u16;

var on_vsync:fn():void;
var locked:u8;

var on_wait_vsync:fn():void;


public function init():void
{
	irq_setup = @null_fn;
	on_vsync = @null_fn;
	on_wait_vsync = @null_fn;
	locked = 1;
}

public function wait_vsync():void
{
	wait_vsync_with_flag(1);
}

function wait_vsync_with_flag(flag:u8):void
{
	// PPU_CTRL2 = 0b00010110; // for debug (profiling)
	if (flag != 2) {
		while (gr_sprite_idx < 255) {
			gr_sprite_buf[gr_sprite_idx] = 255;
			gr_sprite_idx += 1;
		}
	}
	vsync_flag = flag;
	while (vsync_flag) {}
	gr_buf_idx = 0;
	on_wait_vsync();
}

public function lock():void
{
	PPU_CTRL1 = 0b10000000;
	PPU_CTRL2 = 0b00000000;
	locked = 1;
}

public function unlock():void
{
	PPU_CTRL1 = 0b10000000;
	locked = 0;
	wait_vsync();
}

public function put_in_lock(addr:u16, _from:*u8, size:u8):void;

public function fill_in_lock(addr:u16, size:u16, n:u8):void;

public function put(addr:u16, _from:*u8, size:u8, flag:u8):void
{
	while (gr_idx >= GR_MAX) {
		vsync_flag = 2;
		while (vsync_flag) {}
	}
	gr_from_buf[gr_idx] = _from;
	gr_to_buf[gr_idx] = addr;
	gr_size_buf[gr_idx] = size;
	gr_flag_buf[gr_idx] = flag;
	gr_idx += 1;
}

function alloc(size:u8):*u8
{
	var old = gr_buf_idx;
	gr_buf_idx += size;
	return &gr_buf[old];
}

public function pos(x:u8, y:u8):u16;

public function sprite(x:u8, y:u8, pat:u8, mode:u8):void;

function wait(n:u8):void
{
	while (n) {
		var i:u8 = 55;
		while (i) {
			var j:u8 = 255;
			while (j) {
				j -= 1;
			}
			i -= i;
		}
		n -= 1;
	}
}
