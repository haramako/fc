const DEBUG = 0;
public var debug_mode:u8;
public var debug_flag:u8;
public const DEBUG_FLAG_TITLE_SKIP = 1 << 0;
public const DEBUG_FLAG_AUTO_SAVE = 1 << 1;
public const DEBUG_FLAG_FREEJUMP = 1 << 2;
public const DEBUG_FLAG_UP_JUMP = 1 << 3;
public const DEBUG_FLAG_AUTO_ANCHOR = 1 << 4;
public const DEBUG_FLAG_NO_BGM = 1 << 5;

public function debug_on(mask:u8):u8
{
	return debug_mode && debug_flag & mask;
}

// ---- テレメトリ・メールボックス ----
// ホスト側（Web体験版のJS / FCEUXのLua）が tele_seq を毎フレーム監視し、
// 前回からの増分ぶんだけ tele_buf のリングから読み出す。エミュレータの
// 書き込みフックに依存せず、ゲーム側が出したいイベントだけを明示的に出す。
// 実機やフックの無い環境ではただのRAM書き込みなので無害。
// アドレスは hiraeth.map から castle/website/tools/gen-symbols.mjs が抽出する。
public const TELE_AREA = 1; // arg: エリアID
public const TELE_GAME_START = 2; // arg: デバッグモード(0:OFF, 1:ON)
public const TELE_GET_ITEM = 3; // arg: アイテムID
public const TELE_DEAD = 4; // arg: なし
public const TELE_SAVE = 5; // arg: なし
public const TELE_READ_MEMORY = 6; // arg: memory ID
public const TELE_START_GAME = 7; // arg: なし
public const TELE_CLEAR_SAVEDATA = 8; // arg: なし

var tele_seq:u8;
var tele_buf:[32]u8; // [type, arg] x 16 エントリのリング

public function tele(type:u8, arg:u8):void
{
	var i = (tele_seq & 15) * 2;
	tele_buf[i] = type;
	tele_buf[i + 1] = arg;
	tele_seq += 1;
}

