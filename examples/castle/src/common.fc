public function gr_sprite2(x:u8, y:u8, pat:u8, flag:u8):void
{
	if (flag & (1 << 6)) {
		ppu.sprite(x, y - 8, pat, flag);
		ppu.sprite(x - 8, y - 8, pat + 2, flag);
	} else {
		ppu.sprite(x, y - 8, pat + 2, flag);
		ppu.sprite(x - 8, y - 8, pat, flag);
	}
}

public function gr_sprite2_idx(x:u8, y:u8, pat:u8, flag:u8, idx:u8):void
{
	if (flag & (1 << 6)) {
		ppu.sprite_idx(x, y - 8, pat, flag, idx);
		ppu.sprite_idx(x - 8, y - 8, pat + 2, flag, idx + 4);
	} else {
		ppu.sprite_idx(x, y - 8, pat + 2, flag, idx);
		ppu.sprite_idx(x - 8, y - 8, pat, flag, idx + 4);
	}
}

public function heap_strcpy(str:*u8):*u8
{
	var len = mem.strlen(str);
	var buf = heap.alloc(len + 1);
	mem.strcpy(buf, str);
	return buf;
}

