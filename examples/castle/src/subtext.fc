#fc 3
@(bank: 18);
use * from common;
use my;
use bg;
use mem;
use game;
use irqcmd;
use mmc3;

public var subtext_stat:u8;
var subtext_id:u8;
var subtext_count:u8;
var subtext_height:u8;
var subtext_irq_temp:u8;
var subtext_irq_scroll:u8;
public var subtext_shown:u8;

function get_subtext_flag(i:u8):u8
{
	return my.subtext_flags[i / 8] & (1 << (i % 8));
}

function set_subtext_flag(i:u8):void
{
	my.subtext_flags[i / 8] = my.subtext_flags[i / 8] | (1 << (i % 8));
}

function show_subtext(id:u8):void
{
	subtext_stat = 1;
	subtext_count = 0;
	subtext_id = id;
}

function check_subtext():void
{
	if (!subtext_shown && my.y >= 56) {
		if (bg.area_subtext != 0) {
			var flag = get_subtext_flag(bg.area_subtext);
			if (!flag) {
				set_subtext_flag(bg.area_subtext);
				show_subtext(bg.area_subtext);
			}
		}
		subtext_shown = 1;
	}
}

public function process_subtext():void
{
	check_subtext();
	if (!subtext_stat) {
		return;
	}

	subtext_count += 1;

	var buf:*u8;
	var pos:u16;

	switch (subtext_stat) {
	case 1:
		switch (subtext_count) {
		case 1:
			buf = ppu.alloc(64);
			mem.zero(buf, 64);
			ppu.put(0x2c00, buf, 64, 0);
		case 2:
			buf = ppu.alloc(64);
			mem.zero(buf, 64);
			ppu.put(0x2c40, buf, 64, 0);
		case 3:
			buf = ppu.alloc(64);
			mem.zero(buf, 64);
			ppu.put(0x2c80, buf, 64, 0);
		case 4:
			buf = ppu.alloc(64);
			mem.zero(buf, 64);
			ppu.put(0x2fc0, buf, 64, 0);
		case 5:
			buf = ppu.alloc(64);
			var size = fs.copy(buf, fs.AREA_NAME_BASE + subtext_id);
			pos = ppu.pos(14, 3) + 0x0c00;
			ppu.put(pos, buf, size, 0);
		}
		if (subtext_count > 8) {
			subtext_height = 8;
			setup_irqcmd();
			ppu.irq_setup = irqcmd.irq_setup;
			subtext_stat = 2;
		}
	case 2:
		subtext_height += subtext_count % 2;
		setup_irqcmd();
		if (subtext_height >= 24) {
			subtext_stat = 3;
			subtext_count = 0;
		}
	case 3:
		setup_irqcmd();
		if (subtext_count >= 110) {
			subtext_stat = 4;
		}
	case 4:
		subtext_height -= subtext_count % 2;
		setup_irqcmd();
		if (subtext_height <= 8) {
			subtext_stat = 0;
			ppu.irq_setup = ppu.null_func;
		}
	}
}

function setup_irqcmd():void
{
	mmc3.MIRROR = 1; // horizontal
	irqcmd.begin();
	var ppu_ctrl = (ppu.ctrl1_bak & 0b1111_1100) | 2;
	irqcmd.add_wait_line(40 - 1);
	irqcmd.add_screen(subtext_height - 1, 0, 16, 2, ppu_ctrl, 0b00001110, CBANK_TEXT, CBANK_TEXT + 2);
	irqcmd.add_screen(0, 0, 40 + subtext_height + 1, 0, ppu.ctrl1_bak, ppu.ctrl2_bak, mmc3.cbank_bak[0], mmc3.cbank_bak[1]);
	irqcmd.commit();
}
