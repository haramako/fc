#fc 3
@(bank: 10, bss: "BSS_EX");

use * from common;
use * from graphics;
use event2;
use sound;
use mem;
use menu;
use my;
use en_vtbl;
use en;
use ending;
use text;
use game;

@include("event.asm");

public const ID_MOVE_AREA = 2;
public const ID_MOVE_CHECKPOINT = 3;
public const ID_OPEN_MAGMAGATE = 4;
public const ID_CLOSE_MAGMAGATE = 5;
public const ID_SUNGATE = 6;
public const ID_ANCHOR_SWITCH = 7;
public const ID_MEMORY = 9;
public const ID_BIRD_NEST = 10;
public const ID_SOUL_GATE = 11;
public const ID_GAME_CLEAR = 12;
public const ID_OPEN_WATERGATE = 13;
public const ID_TRIAL_ENDING = 14;

function irq_setup():void;

public var event_func:farfn():void;
public var shared_work:[16]u8; // 共有work領域

public function init():void
{
	event_func = null;
}

public function run_event():void
{
	var ev = game_event;
	game_event = 0;
	switch (ev) {
	case ID_MOVE_AREA:
		game.move_area(game_event_p1);
	case ID_MOVE_CHECKPOINT:
		game.move_checkpoint(game_event_p1);
	case ID_OPEN_MAGMAGATE:
		open_magmagate();
	case ID_CLOSE_MAGMAGATE:
		close_magmagate();
	case ID_SUNGATE:
		run_sungate();
	case ID_ANCHOR_SWITCH:
		run_anchor_switch();
	case ID_MEMORY:
		run_memory(game_event_p1);
	case ID_BIRD_NEST:
		run_bird_nest(game_event_p1);
	case ID_SOUL_GATE:
		run_soul_gate();
	case ID_GAME_CLEAR:
		run_game_clear(0);
	case ID_OPEN_WATERGATE:
		event2.run_open_watergate();
	case ID_TRIAL_ENDING:
		run_game_clear(1);
	default:
		if (event_func != null) {
			var f = event_func;
			event_func = null;
			f();
		}
	}
}

//=================================================
// マグマゲート
//=================================================
function open_magmagate():void
{
	var i:u8;
	var j:u8;
	for (i = 0; i < 180; i++) {
		ppu.scroll2 = math.rand() % [2, 4, 8, 8, 4, 2][i / 30];
		ppu.wait_vsync_with_flag(2);
		anim += 1;
		mmc3.set_cbank(0, CBANK_BG_COMMON + (anim / 8) % 4 * 2);
	}
	ppu.scroll2 = 0;
	ppu.wait_vsync_with_flag(2);
	my.flags[my.FLAG_MAGMAGATE] = 1;
}

function close_magmagate():void
{
	var i:u8;
	var j:u8;
	for (i = 0; i < 180; i++) {
		ppu.scroll2 = math.rand() % [2, 4, 8, 8, 4, 2][i / 30];
		ppu.wait_vsync_with_flag(2);
		anim += 1;
		mmc3.set_cbank(0, CBANK_BG_COMMON + (anim / 8) % 4 * 2);
	}
	ppu.scroll2 = 0;
	ppu.wait_vsync_with_flag(2);
}

//=================================================
// 太陽神殿のゲート
//=================================================
function run_sungate():void
{
	var flag = my.flags[my.FLAG_SUNGATE];

	if (((flag & 1) == 0) && my.items[ITEM_ID_KEY_SUN] != 0) {
		sungate_set(flag, 0);
		flag = flag | 1;
	}
	if (((flag & 2) == 0) && my.items[ITEM_ID_KEY_MOON] != 0) {
		sungate_set(flag, 1);
		flag = flag | 2;
	}
	if (((flag & 4) == 0) && my.items[ITEM_ID_KEY_STAR] != 0) {
		sungate_set(flag, 2);
		flag = flag | 4;
	}

	if (flag == 7) {
		sungate_open_gate();
	}

	my.flags[my.FLAG_SUNGATE] = flag;

	ppu.scroll2 = 0;
	ppu.wait_vsync_with_flag(2);
}

function sungate_set(flag:u8, key_idx:u8):void
{
	var i:u8;
	for (i = 0; i < 60; i++) {
		ppu.scroll2 = math.rand() % 4;
		my.draw();
		draw_sungate(flag);
		draw_key(key_idx, i / 2 - 30);
		ppu.wait_vsync();
		anim += 1;
		mmc3.set_cbank(0, CBANK_BG_COMMON + (anim / 8) % 4 * 2);
	}
}

function draw_sungate(flag:u8):void
{
	if (anim % 2 == 0) {
		var spr = SPR_SLOT[1] + SPR_SUNGATE;
		var pal = PAL_SLOT[1];
		if (flag & 1)
			gr_sprite2(9 * 16 + 8, 2 * 16 + 8, spr, pal);
		if (flag & 2)
			gr_sprite2(7 * 16 + 8, 5 * 16 + 8, spr + 1 * 4, pal);
		if (flag & 4)
			gr_sprite2(11 * 16 + 8, 5 * 16 + 8, spr + 2 * 4, pal);
	}
}

function draw_key(idx:u8, y:u8):void
{
	var spr = SPR_SLOT[1] + SPR_SUNGATE;
	var pal = PAL_SLOT[1];
	if (idx == 0)
		gr_sprite2(9 * 16 + 8, 2 * 16 + 8 + y, spr, pal);
	if (idx == 1)
		gr_sprite2(7 * 16 + 8, 5 * 16 + 8 + y, spr + 1 * 4, pal);
	if (idx == 2)
		gr_sprite2(11 * 16 + 8, 5 * 16 + 8 + y, spr + 2 * 4, pal);
}

function sungate_open_gate():void
{
	var i:u8;
	var n = 0;
	for (i = 0; i < 60; i++) {
		ppu.scroll2 = math.rand() % 4;
		my.draw();
		if (i > 20 && i % 4 == 0) {
			if (n < 8) {
				var buf = ppu.alloc(4);
				mem.zero(buf, 4);
				var addr = ppu.pos(0, 21 - n);
				ppu.put(addr, buf, 4, 0);
			}
			n += 1;
		}

		draw_sungate(7);
		ppu.wait_vsync();
		anim += 1;
		mmc3.set_cbank(0, CBANK_BG_COMMON + (anim / 8) % 4 * 2);
	}

	var x:u8;
	var y:u8;
	for (x = 0; x < 2; x++) {
		for (y = 0; y < 4; y++) {
			bg.put2(x, 7 + y, 0, 0);
		}
	}
}

//=================================================
// 錨生成器
//=================================================
public function register_anchor_switch():void
{
	event_func = run_anchor_switch;
}

function run_anchor_switch():void
{
	var i:u8;
	var y:i8 = 72;

	for (i = 0; i < 16; i++) {
		var buf = ppu.alloc(6);
		mem.set(buf, 255, 6);
		var addr = ppu.pos(18, i);
		ppu.put(addr, buf, 6, 0);

		draw_anchor_generater(152, y);
		my.draw();
		ppu.wait_vsync();
	}

	var stat = 0;
	var wait = 0;
	while (stat < 3) {
		switch (stat) {
		case 0:
			wait += 1;
			if (wait > 60) {
				stat = 1;
				wait = 0;
			}
		case 1:
			if (anim % 2 == 0) {
				wait += 1;
				y -= 1;
				if (wait > 144) {
					stat = 2;
					wait = 0;
				}
			}
		case 2:
			wait += 1;
			if (wait > 60) {
				stat = 3;
			}
		}
		ppu.scroll2 = math.rand() % 4;
		my.draw();
		draw_anchor_generater(152, y);
		ppu.wait_vsync();
		anim += 1;
		mmc3.set_cbank(0, CBANK_BG_COMMON + (anim / 8) % 4 * 2);
	}
	ppu.scroll2 = 0;

	my.flags[my.FLAG_ANCHOR_GENERATOR] = 1;
}

const SPR_ANCHOR_GATE = SPR_SLOT_A + 10 * 4;

const anchor_x = [0, 16, 32, 0, 32, 0, 32, 0, 16, 32];
const anchor_y = [0, 0, 0, 16, 16, 32, 32, 48, 48, 48];
const anchor_p = [0, 4, 8, 16, 16, 16, 16, 12, 12, 12];

function draw_anchor_generater(x:u8, y:i8):void
{
	var i:u8;
	for (i = 0; i < 10; i++) {
		var px:u8 = x + anchor_x[i];
		var py:i8 = y + anchor_y[i];
		if (py >= 0) {
			gr_sprite2(px, py, SPR_ANCHOR_GATE + anchor_p[i], PAL_SLOT_A);
		}
	}

	while (y >= 0) {
		gr_sprite2(x + 16, y - 16, SPR_ANCHOR_GATE + 20, PAL_SLOT_A);
		y -= 16;
	}

	gr_sprite2(5 * 16 - 8, 9 * 16 - 8, 128 + SPR_ANCHOR_SWITCH, PAL_SLOT_A);
}

//=================================================
// 記憶のかけら
//=================================================
function run_memory(memory_id:u8):void
{
	ppu.lock();
	var old_ppu_ctrl1 = ppu.ctrl1_bak;
	var old_cbank0 = mmc3.set_cbank(0, CBANK_MEMORY_TEXT + 0);
	var old_cbank1 = mmc3.set_cbank(1, CBANK_MEMORY_TEXT + 2);
	var old_cbank2 = ppu.cbank2;
	ppu.cbank2 = CBANK_SYS_SPRITE;
	mmc3.MIRROR = 0; // vertical
	ppu.ctrl1_bak = 0b10100001;
	ppu.irq_setup = ppu.null_func;

	my.clear_sprites();

	ppu.put_in_lock(0x3f00, ITEM_PAL, 16);
	ppu.fill_in_lock(0x2400, 0x400, 0);

	my.set_memory(memory_id);
	memory_draw(memory_id);

	ppu.unlock();

	run_memory_main();

	ppu.irq_setup = ppu.null_func;
	ppu.wait_vsync();
	ppu.lock();
	mmc3.set_cbank(0, old_cbank0);
	mmc3.set_cbank(1, old_cbank1);
	ppu.cbank2 = old_cbank2;
	ppu.ctrl1_bak = old_ppu_ctrl1;
	ppu.put_in_lock(0x3f00, bg.pallet, 16);
	ppu.unlock();
	ppu.wait_vsync();
}

function run_memory_main():void
{
	loop {
		pad.update();
		if (pad.pushed & pad.A) {
			break;
		}
		ppu.wait_vsync();
	}
}

function memory_draw(id:u8):void
{
	var data_buf = &bg.data_buf[0];
	var data = data_buf;
	data_buf += 256;
	fs.copy(data, fs.MEMORIES_BASE + id);
	var buf = data_buf;
	data_buf += 256;
	mem.zero(buf, 255);
	text.print(buf, data, 32);
	var addr = ppu.pos(4, 8) + 0x400;
	ppu.put_in_lock(addr, buf, 255);
}

//=================================================
// 鳥の巣ワープ
//=================================================
const BIRD_NEST_MOVE_TO_AREA:[]u8 = [
	7 * 16 + 12,
	3 * 16 + 2
];

const BIRD_NEST_X:[]u8 = [
	4 * 16 + 8,
	9 * 16 + 8
];

const BIRD_NEST_Y:[]u8 = [
	7 * 16 + 8,
	8 * 16 + 8
];

function run_bird_nest(nest_id:u8):void
{
	var j:u8;

	light_down();

	ppu.wait_vsync_with_flag(2);

	ppu.lock();
	my.x = BIRD_NEST_X[nest_id];
	my.y = BIRD_NEST_Y[nest_id];
	move_area_locked(BIRD_NEST_MOVE_TO_AREA[nest_id]);
	ppu.unlock();

	for (j = 0; j < 20; j++) {
		ppu.wait_vsync_with_flag(2);
	}

	sound.crossfade_jingle(sound.BGM_BIGBIRD, 60);

	for (j = 0; j < 255; j++) {
		ppu.wait_vsync_with_flag(2);
	}

	sound.jingle_force_finished = 1;

	light_undown();
}

function light_down():void
{
	var buf = ppu.alloc(32);
	var i:u8;
	for (i = 0; i < 4; i++) {
		mem.copy(buf, bg.pallet, 32);
		bg.pal_down(buf, 32, i + 1);
		ppu.put(VRAM_PALETTE, buf, 32, 0);
		var j:u8;
		for (j = 0; j < 10; j++) {
			ppu.wait_vsync_with_flag(2);
		}
	}
}

function light_undown():void
{
	var buf = ppu.alloc(32);
	var i:u8;
	for (i = 0; i < 4; i++) {
		mem.copy(buf, bg.pallet, 32);
		bg.pal_down(buf, 32, 3 - i);
		ppu.put(VRAM_PALETTE, buf, 32, 0);
		var j:u8;
		for (j = 0; j < 10; j++) {
			ppu.wait_vsync_with_flag(2);
		}
	}
}

function move_area_locked(area:u8):void
{
	bg.fetch_area(area, DIR_NONE);
	game.init_area_enemy();

	bg.update_palette(1);
	bg.draw_screen();

	var buf = ppu.alloc(32);
	mem.copy(buf, bg.pallet, 32);
	bg.pal_down(buf, 32, 4);
	ppu.put_in_lock(VRAM_PALETTE, buf, 32);
	my.draw();
}

//=================================================
// 太陽神殿のゲート
//=================================================
function run_soul_gate():void
{
	var changed = 0;
	var flag = my.flags[my.FLAG_SOUL_GATE];

	var i:u8;
	for (i = 0; i < 6; i++) {
		var mask = 1 << i;
		if (((flag & mask) == 0) && my.items[ITEM_ID_ORB1 + i] != 0) {
			flag = flag | mask;
			changed = 1;
		}
	}

	if ((flag & 0b1000000) == 0) {
		flag = flag | 0b1000000;
		changed = 1;
	}

	my.flags[my.FLAG_SOUL_GATE] = flag;

	// ゴゴゴゴ
	if (changed) {
		for (i = 0; i < 120; i++) {
			ppu.scroll2 = math.rand() % 4;
			my.draw();

			ppu.wait_vsync();
			anim += 1;
		}
	}

	ppu.scroll2 = 0;
	ppu.wait_vsync_with_flag(2);
}

//=================================================
// ゲームクリア
//=================================================
function run_game_clear(is_trial:u8):void
{
	var j:u8;

	light_up();

	ppu.wait_vsync_with_flag(2);

	for (j = 0; j < 100; j++) {
		ppu.wait_vsync_with_flag(2);
	}

	ending.start(is_trial);
}

function light_up():void
{
	var buf = ppu.alloc(32);
	var i:u8;
	for (i = 0; i < 5; i++) {
		mem.copy(buf, bg.pallet, 32);
		bg.pal_up(buf, 32, i);
		ppu.put(VRAM_PALETTE, buf, 32, 0);
		var j:u8;
		for (j = 0; j < 20; j++) {
			ppu.wait_vsync_with_flag(2);
		}
	}
}
