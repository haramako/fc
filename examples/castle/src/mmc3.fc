#fc 3
@(mapper: "MMC3", farcall);
@(static_zp: 64, static_ram: 256); // 静的フレームの領域 (data.asm の FC_SZP_SIZE / FC_SRAM_SIZE と一致)
@(bank: -1);

//
//
// See: http://wiki.nesdev.com/w/index.php/Nintendo_MMC3

var BANK_SELECT:u8 @(address: 0x8000);
var BANK_DATA:u8 @(address: 0x8001);
public var MIRROR:u8 @(address: 0xA000);
public var RAM_PROTECT:u8 @(address: 0xA001);
var IRQ_LATCH:u8 @(address: 0xC000);
var IRQ_RELOAD:u8 @(address: 0xC001);
var IRQ_DISABLE:u8 @(address: 0xE000);
var IRQ_ENABLE:u8 @(address: 0xE001);
public var select_shadow:u8;
public var cbank_bak:[6]u8;
public var pbank_bak:[2]u8;

@include("mmc3.asm");

/**
 * 初期化する.
 */
public function init():void
{
	set_cbank(0, 0);
	set_cbank(1, 2);
	set_cbank(2, 0);
	set_cbank(3, 1);
	set_cbank(4, 2);
	set_cbank(5, 3);
	set_pbank(0, 0);
	set_pbank(1, 1);
	MIRROR = 0;
	IRQ_DISABLE = 0;
}

/**
 * VROMのバンク切り替えを行う.
 *
 * pos:
 *   0: 0x0000-0x07FF ( 2KB )
 *   1: 0x0800-0x0FFF ( 2KB )
 *   2: 0x1000-0x13FF ( 1KB )
 *   3: 0x1400-0x17FF ( 1KB )
 *   4: 0x1800-0x1BFF ( 1KB )
 *   5: 0x1C00-0x1FFF ( 1KB )
 * bank: 1KB bank
 */
public function set_cbank(pos:u8, bank:u8):u8
{
	var old = cbank_bak[pos];
	if (cbank_bak[pos] != bank) {
		@asm("sei");
		select_shadow = pos; // NMI割り込み中の変更にBANK_SELECTの値が変更されるときの対策
		BANK_SELECT = pos;
		BANK_DATA = bank;
		cbank_bak[pos] = bank;
		@asm("cli");
	}
	return old;
}

/**
 * ROMのバンク切り替えを行う.
 *
 * pos: 
 *   0: 0x8000-0x9FFF ( 8KB )
 *   1: 0xA000-0xBFFF ( 8KB )
 * bank: 8KB bank
 */
public function set_pbank(pos:u8, bank:u8):u8
{
	var old = pbank_bak[pos];
	if (pbank_bak[pos] != bank) {
		@asm("sei");
		select_shadow = pos; // NMI割り込み中の変更にBANK_SELECTの値が変更されるときの対策
		pbank_bak[pos] = bank;
		BANK_SELECT = pos + 6;
		BANK_DATA = bank;
		@asm("cli");
	}
	return old;
}
