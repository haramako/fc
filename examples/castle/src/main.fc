#fc 3
// ビルド: fcc build -t nes -g -o ../hiraeth.nes main.fc (自前の base / ld65.cfg / NSD のライブラリを options で指定。Rakefile 参照)
@(base: "data.asm");
@(linker_config: "../ld65.cfg");
@(link: "../res/sound/bgm.o ../res/sound/castle.o ../nsd/lib/NSD.lib");
@include("main.asm");

use * from common;
use game;
use en;
use my;
use sound;
use title;
use savedata;
use ending;
use heap;
use irqcmd;
use event;
use text;

@include('../res/images/bg_common.chr');
@include('../res/images/bg.chr');
@include('../res/images/sprite.chr');
@include('../tmp/font/text_merged.chr');
@include('../res/images/item.chr');
@include('../tmp/font/misc_text.chr');
@include('../res/images/title.chr');
@include('../res/images/sys_sprite.chr');
@include('../res/images/menu.chr');
@include('../res/images/my.chr');
@include('../res/images/minimap.chr');
@include('../tmp/font/ending_text.chr');
@include('../tmp/font/memory_text.chr');
@include('../tmp/font/item_text_merged.chr');
@include('../res/images/marchant.chr');

function main():void
{
	ppu.lock();
	mmc3.init();

	nes.APU_INTERRUPT = 0x40; // disable APU IRQ
	mmc3.MIRROR = 1; // horizontal
	mmc3.RAM_PROTECT = 0b10000000;

	savedata.init();
	savedata.load();

	ppu.init();
	bg.init();
	en.init();
	my.init();
	heap.init();
	irqcmd.init();
	event.init();
	ppu.clear_out_sprite();
	text.talk_init();

	// play music
	sound.init();
	ppu.on_vsync = sound.main_nsd;
	ppu.on_wait_vsync = ->fn():void {
		bg.buf_idx = 0;
		sound.process_frame();
	};

	@asm("cli");

	// エンディングテスト
	if (0) {
		ending.start(1);
	}

	if (!debug_on(DEBUG_FLAG_TITLE_SKIP)) {
		title.start();
	}

	tele(TELE_GAME_START, 0);
	game.start();
}
