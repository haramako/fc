#fc 3
@(bank: 23, bss: "BSS_EX");

use * from common;
use mem;
use mmc3;
use heap;

// strはbank awareである必要は「ない」
public function screen_print_str(addr:u16, str:*const u8, width:u8, height:u8):u8 @(segment: "common")
{
	var len = mem.strlen(str) + 1;
	var str_buf = ppu.alloc(len);
	mem.strcpy(str_buf, str);
	var buf = ppu.alloc(width * height * 2);
	return screen_print(addr, buf, str_buf, width, height);
}

// strはbank awareである必要は「ない」
function screen_print_str_in_lock(addr:u16, str:*const u8, width:u8, height:u8):u8 @(segment: "common")
{
	var len = mem.strlen(str) + 1;
	var str_buf = ppu.alloc(len);
	mem.strcpy(str_buf, str);
	var buf = ppu.alloc(width * height * 2);
	return screen_print_in_lock(addr, buf, str_buf, width, height);
}

// MEMO: strはbank aware である必要があるので注意
public function print_num(p:*u8, n:u8, base_chr:u8 = 5):u8
{
	var i:u8;
	for (i = 0; i < 3; i++) {
		var c = base_chr /* "0" */ + n % 10;
		n = n / 10;
		p[2 - i] = c;
	}
	return i;
}

// MEMO: strはbank aware である必要があるので注意
public function print(p:*u8, str:*const u8, width:u8):u8
{
	var i = 0;
	var pi = 0;
	while (1) {
		var c = str[i];
		if (c == 0) {
			break;
		}
		if (c == 3 || c == 4) {
			// 濁音、半濁音の処理
			p[pi] = c;
		} elsif (c == 2) {
			// 改行
			p += width * 2;
			pi = 0;
		} else {
			// 通常の文字
			p[pi + width] = c;
			pi += 1;
			if (pi >= width) {
				// 改行
				p += width * 2;
				pi = 0;
			}
		}
		i += 1;
	}
	return 0;
}

// MEMO: strはbank aware である必要があるので注意
function screen_print(addr:u16, buf:*u8, str:*u8, width:u8, height:u8):u8
{
	mem.zero(buf, width * height * 2);
	print(buf, str, width);
	var height2 = height * 2;
	var i:u8;
	var count = 0;
	for (i = 0; i < height2; i++) {
		ppu.put(addr, buf, width, 0);
		buf += width;
		addr += 32;
		count += width;
		if (count >= 32) {
			ppu.wait_vsync_with_flag(2);
			count = 0;
		}
	}
	return 0;
}

// MEMO: strはbank aware である必要があるので注意
function screen_print_in_lock(addr:u16, buf:*u8, str:*u8, width:u8, height:u8):u8
{
	mem.zero(buf, width * height * 2);
	print(buf, str, width);
	var height2 = height * 2;
	var i:u8;
	var count = 0;
	for (i = 0; i < height2; i++) {
		ppu.put_in_lock(addr, buf, width);
		buf += width;
		addr += 32;
		count += width;
	}
	return 0;
}

//=================================================
// 文字送り
//=================================================

const MAX_TASK = 4;

struct TalkTask {
	stat:u8; /* 0: 非アクティブ、 1:クリーン, 2: 文字送り */
	addr:u16;
	str:*u8;
	width:u8;
	height:u8;

	cur:u8; // 現在のカーソル位置
	cur_x:u8; // 現在の相対X位置
	cur_y:u8; // 現在の相対Y位置
}

soa talk_tasks:[MAX_TASK]TalkTask;

public function talk_init():void
{
	for (var i = 0; i < MAX_TASK; i++) {
		talk_tasks[i].stat = 0;
		talk_tasks[i].str = null;
	}
}

public function talk_release_all():void
{
	for (var i = 0; i < MAX_TASK; i++) {
		talk_release(i);
	}
}

public function talk_process_all():bool
{
	var running = false;
	for (var i = 0; i < MAX_TASK; i++) {
		running |= talk_process(i);
	}
	return running;
}

public function talk_release(id:u8):void
{
	var t = &talk_tasks[id];
	t.stat = 0;
	if (t.str != null) {
		//heap.release(t.str);
	}
}

public function talk_set(id:u8, addr:u16, str:*u8, width:u8, height:u8):void
{
	var t = &talk_tasks[id];
	t.stat = 1;
	t.addr = addr;
	t.str = str;
	t.width = width;
	t.height = height;
	t.cur = 0;
	t.cur_x = 0;
	t.cur_y = 0;
}

public function talk_process(id:u8):bool
{
	var t = &talk_tasks[id];
	var buf:*u8;
	switch (t.stat) {
	case 0:
	// DO NOTHING
	case 1:
		buf = ppu.alloc(t.width);
		mem.zero(buf, t.width);
		ppu.put(t.addr + 64 * t.cur_y, buf, t.width, ppu.HORIZONTAL);
		ppu.put(t.addr + 64 * t.cur_y + 32, buf, t.width, ppu.HORIZONTAL);
		ppu.wait_vsync_with_flag(2);
		t.cur_y++;
		if (t.cur_y >= t.height) {
			t.cur_y = 0;
			t.stat = 2;
		}
	case 2:
		var fill_rest = false;
		buf = ppu.alloc(2);
		var c = t.str[t.cur];
		t.cur++;
		if (c == 0) {
			t.stat = 0;
			fill_rest = true;
		} elsif (c == 3 || c == 4) {
			// 濁点/半濁点
			buf[0] = c;
			buf[1] = t.str[t.cur];
			t.cur++;
		} elsif (c == 2) {
			// 改行
			fill_rest = true;
		} else {
			buf[0] = 0;
			buf[1] = c;
		}

		if (fill_rest) {
			var w = t.width - t.cur_x;
			if (w > 0) {
				buf = ppu.alloc(w);
				mem.zero(buf, w);
				var addr = t.addr + 64 * t.cur_y + t.cur_x;
				ppu.put(addr, buf, w, ppu.HORIZONTAL);
				ppu.put(addr + 32, buf, w, ppu.HORIZONTAL);
				t.cur_x = 0;
				t.cur_y += 1;
			}
		} else {
			ppu.put(t.addr + 64 * t.cur_y + t.cur_x, buf, 2, ppu.VERTICAL);
			t.cur_x++;
		}
	}

	return t.stat != 0;
}
