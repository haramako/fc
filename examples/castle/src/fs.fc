#fc 3
@(bank: -1);

public use * from common;
use mem;
public use * from fs_config;

const BASE = 0xa000;
const BANK_SIZE = 0x2000;

public function copy(to:*u8, idx:u16):u8
{
	var old_bank = mmc3.set_pbank(1, PBANK_FS);
	var offset = FILE_ADDR[idx];
	var bank:u8 = offset / BANK_SIZE;
	var addr = @bitcast(*u8, BASE + (offset & (BANK_SIZE - 1)));
	var size = FILE_SIZE[idx];

	mmc3.set_pbank(1, (PBANK_FS + 1) + bank);
	mem.copy(to, addr, size);

	mmc3.set_pbank(1, old_bank);
	return size;
}
