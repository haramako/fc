#fc 3
@(bank: 19);
use * from common;
use my;
use bg;
use mem;
use menu;
use sound;
use text;
use irqcmd;
use heap;
use event;

//=================================================
// 水門オープン
//=================================================
public function run_open_watergate():void
{
	if (my.flags[my.FLAG_WATERGATE] == 0) {
		watergate_open();
		my.flags[my.FLAG_WATERGATE] = 1;
	} else {
		watergate_close();
		my.flags[my.FLAG_WATERGATE] = 0;
	}
}

function watergate_open():void
{
	var i:u8;
	var j:u8;
	for (i = 0; i < 180; i++) {
		ppu.scroll2 = math.rand() % [2, 4, 8, 8, 4, 2][i / 30];
		ppu.wait_vsync_with_flag(2);
		anim += 1;
		mmc3.set_cbank(0, CBANK_BG_COMMON + (anim / 8) % 4 * 2);
		switch (i) {
		case 50:
			bg.put2(9, 4, 0, 0);
			bg.put2(9, 11, 38, 0);
		case 60:
			bg.put2(9, 5, 0, 0);
			bg.put2(9, 12, 38, 0);
		default:
			if (i % 2 == 0 && i >= 70 && i < (70 + 12 * 3)) {
				var x = (i - 70) % 12 / 2;
				var y = (i - 70) / 12;
				bg.put2(10 + x, 10 + y, 0, 0);
				if (y < 2)
					bg.put2(10 + x, 11 + y, 24, 0);
			}
		}
	}
	ppu.scroll2 = 0;
	ppu.wait_vsync_with_flag(2);
}

function watergate_close():void
{
	var i:u8;
	var j:u8;
	for (i = 0; i < 180; i++) {
		ppu.scroll2 = math.rand() % [2, 4, 8, 8, 4, 2][i / 30];
		ppu.wait_vsync_with_flag(2);
		anim += 1;
		mmc3.set_cbank(0, CBANK_BG_COMMON + (anim / 8) % 4 * 2);
		switch (i) {
		case 50:
			bg.put2(9, 5, 38, 0);
			bg.put2(9, 12, 0, 0);
		case 60:
			bg.put2(9, 4, 38, 0);
			bg.put2(9, 11, 0, 0);
		default:
			if (i % 2 == 0 && i >= 70 && i < (70 + 12 * 3)) {
				var x = (i - 70) % 12 / 2;
				var y = (i - 70) / 12;
				if (y > 0)
					bg.put2(10 + x, 13 - y, 0, 0);
				bg.put2(10 + x, 12 - y, 24, 0);
			}
		}
	}
	ppu.scroll2 = 0;
	ppu.wait_vsync_with_flag(2);
}

//=================================================
// 確認ダイアログ
//=================================================

struct ConfirmDialog {
	scroll:u8; // MessageDialog/ConfirmDialogと共用
	text:*u8;
	default_cur:u8;
	callback:farfn(u8):void;
	cur:u8;
	old_cur:u8;
	cur_anim:u8;
}

alias cdlg:ConfirmDialog = event.shared_work;

// 確認ダイアログを開く
// strはheapにコピーされる。bankを切り替えないために common セグメントに常駐する
public function register_confirm_dialog(str:*u8, callback:farfn(u8):void, default_cur:u8 = 0):void @(segment: "common")
{
	event.event_func = run_confirm_dialog;
	cdlg.text = heap_strcpy(str);
	cdlg.default_cur = default_cur;
	cdlg.callback = callback;
	cdlg.scroll = 0;
	cdlg.cur = default_cur;
	cdlg.old_cur = default_cur;
}

function ppu_clear():void
{
	var buf = ppu.alloc(64);
	mem.set(buf, 0, 64);
	var i:u8;
	for (i = 0; i < 5; i++) {
		var addr = ppu.pos(0, i * 2) + 0x800;
		ppu.put(addr, buf, 64, 0);
		ppu.wait_vsync_with_flag(2);
	}
	ppu.put(0x2fc0, buf, 64, 0);
	ppu.wait_vsync_with_flag(2);
}

const mark_str = [255, /*→*/ 0];

function run_confirm_dialog():void
{
	mmc3.MIRROR = 1; // horizontal
	ppu_clear();

	var line_buf = ppu.alloc(32);
	mem.set(line_buf, 254, 32);
	ppu.put(ppu.pos(0, 1) + 0x800, line_buf, 32, 0);
	ppu.put(ppu.pos(0, 9) + 0x800, line_buf, 32, 0);
	ppu.wait_vsync_with_flag(2);

	irqcmd.begin();
	irqcmd.commit();

	ppu.irq_setup = irqcmd.irq_setup;

	var h = 24;

	// ウィンドウ開く
	while (h > 0) {
		h -= 1;
		confirm_setup_irqcmd(h);
		ppu.wait_vsync_with_flag(2);
	}

	// 文字描画
	text.screen_print_str(ppu.pos(6, 2) + 0x800, cdlg.text, 20, 2);
	text.screen_print_str(ppu.pos(8, 6) + 0x800, _T("はい"), 4, 1);
	text.screen_print_str(ppu.pos(20, 6) + 0x800, _T("いいえ"), 4, 1);

	// 選択肢入力
	while (1) {
		pad.update();
		if (pad.pushed & pad.LEFT) {
			cdlg.cur = 1 - cdlg.cur;
		}
		if (pad.pushed & pad.RIGHT) {
			cdlg.cur = 1 - cdlg.cur;
		}
		if (pad.pushed & pad.A)
			break;
		if (pad.pushed & pad.B) {
			cdlg.cur = 1;
			break;
		}

		confirm_redraw_cursor();

		confirm_setup_irqcmd(h);

		ppu.wait_vsync_with_flag(2);
	}

	// カーソル点滅
	cdlg.cur_anim = 0;
	for (var i = 0; i < 32; i++) {
		confirm_redraw_cursor();
		cdlg.cur_anim += 3;
		ppu.wait_vsync_with_flag(2);
	}

	// ウィンドウ閉じる
	while (h < 24) {
		h += 1;
		confirm_setup_irqcmd(h);
		ppu.wait_vsync_with_flag(2);
	}

	heap.release(cdlg.text);
	ppu.irq_setup = @null_fn;
	ppu.wait_vsync_with_flag(2);
	if (cdlg.callback != null) {
		cdlg.callback(cdlg.cur);
	}
}

function confirm_setup_irqcmd(h:u8):void
{
	irqcmd.begin();
	irqcmd.add_wait_line(80 - 1 + h);
	irqcmd.add_screen(8, cdlg.scroll / 2, 8, 2, 0b10100010, 0b0000_1010, CBANK_TEXT, CBANK_TEXT + 2);
	irqcmd.add_screen(56 - h * 2, 0, 16 + h, 2, 0b10100010, 0b0000_1010, CBANK_TEXT, CBANK_TEXT + 2);
	irqcmd.add_screen(8, -cdlg.scroll / 2, 8, 2, 0b10100010, 0b0000_1010, CBANK_TEXT, CBANK_TEXT + 2);
	irqcmd.add_screen(0, 0, 156 - h, 0, ppu.ctrl1_bak, ppu.ctrl2_bak, mmc3.cbank_bak[0], mmc3.cbank_bak[1]);
	irqcmd.commit();
	cdlg.scroll += 1;
}

const CONFIRM_CURSOR_X = [7, 19];
const CONFIRM_CURSOR_Y = [7, 7];

function confirm_redraw_cursor():void
{
	if (cdlg.old_cur != cdlg.cur) {
		confirm_draw_cursor(cdlg.old_cur, 0);
		cdlg.old_cur = cdlg.cur;
		cdlg.cur_anim = 0;
	}

	if (cdlg.cur_anim % 32 == 0) {
		confirm_draw_cursor(cdlg.cur, 255);
	} elsif (cdlg.cur_anim % 32 == 16) {
		confirm_draw_cursor(cdlg.cur, 0);
	}
	cdlg.cur_anim += 1;
}

function confirm_draw_cursor(idx:u8, chr:u8):void
{
	var addr = ppu.pos(CONFIRM_CURSOR_X[idx], CONFIRM_CURSOR_Y[idx]) + 0x800;
	var buf = ppu.alloc(1);
	buf[0] = chr;
	ppu.put(addr, &buf[0], 1, 0);
}

//=================================================
// メッセージダイアログ
//=================================================

public const MESSAGE_DIALOG_NONE = 0;
public const MESSAGE_DIALOG_ITEM = 1;

struct MessageDialog {
	scroll:u8; // MessageDialog/ConfirmDialogと共用
	text:*u8;
	kind:u8;
	param:u8;
	callback:farfn():void;
}

alias msgdlg:MessageDialog = event.shared_work;

// メッセージダイアログを開く
// strはheapにコピーされる。bankを切り替えないために common セグメントに常駐する
public function register_message_dialog(str:*u8, callback:farfn():void = null, kind:u8 = 0, p2:u8 = 0):void @(segment: "common")
{
	event.event_func = run_message_dialog;
	msgdlg.text = heap_strcpy(str);
	msgdlg.kind = kind;
	msgdlg.param = p2;
	msgdlg.callback = callback;
	msgdlg.scroll = 0;
}

// メッセージダイアログの処理
// game_event_ptr1の文字列の所有権は渡されて、この関数で解放される
function run_message_dialog():void
{
	mmc3.MIRROR = 1; // horizontal
	ppu_clear();

	// 飾り枠を描画
	var line_buf = ppu.alloc(32);
	mem.set(line_buf, 254, 32);
	var addr = ppu.pos(0, 1) + 0x800;
	ppu.put(addr, line_buf, 32, 0);
	addr = ppu.pos(0, 9) + 0x800;
	ppu.put(addr, line_buf, 32, 0);
	ppu.wait_vsync_with_flag(2);

	irqcmd.begin();
	irqcmd.commit();

	ppu.irq_setup = irqcmd.irq_setup;

	var h = 27;

	// ウィンドウ開く
	while (h > 0) {
		h -= 1;
		confirm_setup_irqcmd(h);
		ppu.wait_vsync_with_flag(2);
	}

	// 文字描画
	text.screen_print_str(ppu.pos(6, 2) + 0x800, msgdlg.text, 20, 3);

	if (msgdlg.kind == MESSAGE_DIALOG_ITEM) {
		if (msgdlg.param) {
			sound.crossfade_jingle(sound.BGM_OPEN_GREAT_CHEST, 60);
		} else {
			sound.crossfade_jingle(sound.BGM_OPEN_CHEST, 60);
		}
	}

	// 選択肢入力
	while (1) {
		pad.update();
		var finished = true;
		if (msgdlg.kind == MESSAGE_DIALOG_ITEM) {
			finished = sound.jingle_finished;
		}

		if (finished) {
			if (pad.pushed & pad.A)
				break;
			if (pad.pushed & pad.B)
				break;
		}

		message_redraw_cursor();

		confirm_setup_irqcmd(h);

		ppu.wait_vsync_with_flag(2);
	}

	// カーソル点滅
	/*
	var i:int;
	confirm_cur_anim = 0;
	for (i = 0; i < 32; i++) {
		message_redraw_cursor();
		confirm_cur_anim += 3;
		ppu.wait_vsync_with_flag(2);
	}
	*/

	// ウィンドウ閉じる
	while (h < 27) {
		h += 1;
		confirm_setup_irqcmd(h);
		ppu.wait_vsync_with_flag(2);
	}

	heap.release(msgdlg.text);
	ppu.irq_setup = @null_fn;
	ppu.wait_vsync_with_flag(2);
	if (msgdlg.callback != null) {
		msgdlg.callback();
	}
}

function message_redraw_cursor():void {}
