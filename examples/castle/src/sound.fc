#fc 3
use mmc3;
use * from common;

@include("../nsd/include/nsd.inc");
@include("sound.asm");

// 0x00d0..0x00ff, 0x6500..0x67ff までは、NSDが使用する

public const BGM_GAME_START = 0;
public const BGM_RIDDLE_SOLVED = 1;
public const BGM_BIGBIRD = 2;
public const BGM_SONG = 3;
public const BGM_OPEN_CHEST = 4;
public const BGM_OPEN_GREAT_CHEST = 5;
public const BGM_TITLE = 6;
public const BGM_GROUND = 7;
public const BGM_UNDERGROUND = 8;
public const BGM_TEMPLE_OF_SUN = 9;
public const BGM_ENDING = 10;

public const SE_JUMP = 0;
public const SE_COIN = 1;
public const SE_WATER_SPLASH = 2;
public const SE_CHECKPOINT_BELL = 3;
public const SE_DEAD = 4;
public const SE_OPEN_DOOR = 5;
public const SE_SHOOT = 6;
public const SE_PUSH_ROCK = 7;
const SE_HIT = 8;
public const SE_SAVEPOINT = 9;
const SE_ROCK_CRASHED = 10;
const SE_LAVA_FIXED = 11;
public const SE_PUSH_BUTTON = 12;

// BGM / SE データ (res/sound/*.mml → .o のシンボル。fc が .global を出すので asm 側の宣言は不要)
const BGM0:[]u8 @(symbol: "_nsd_bgm_BGM0");
const BGM1:[]u8 @(symbol: "_nsd_bgm_BGM1");
const BGM2:[]u8 @(symbol: "_nsd_bgm_BGM2");
const BGM3:[]u8 @(symbol: "_nsd_bgm_BGM3");
const BGM4:[]u8 @(symbol: "_nsd_bgm_BGM4");
const BGM5:[]u8 @(symbol: "_nsd_bgm_BGM5");
const BGM6:[]u8 @(symbol: "_nsd_bgm_BGM6");
const BGM7:[]u8 @(symbol: "_nsd_bgm_BGM7");
const BGM8:[]u8 @(symbol: "_nsd_bgm_BGM8");
const BGM9:[]u8 @(symbol: "_nsd_bgm_BGM9");
const BGM10:[]u8 @(symbol: "_nsd_bgm_BGM10");
const bgm_table:[]*u8 = [BGM0, BGM1, BGM2, BGM3, BGM4, BGM5, BGM6, BGM7, BGM8, BGM9, BGM10];

const SE0:[]u8 @(symbol: "_nsd_se_SE0");
const SE1:[]u8 @(symbol: "_nsd_se_SE1");
const SE2:[]u8 @(symbol: "_nsd_se_SE2");
const SE3:[]u8 @(symbol: "_nsd_se_SE3");
const SE4:[]u8 @(symbol: "_nsd_se_SE4");
const SE5:[]u8 @(symbol: "_nsd_se_SE5");
const SE6:[]u8 @(symbol: "_nsd_se_SE6");
const SE7:[]u8 @(symbol: "_nsd_se_SE7");
const SE8:[]u8 @(symbol: "_nsd_se_SE8");
const SE9:[]u8 @(symbol: "_nsd_se_SE9");
const SE10:[]u8 @(symbol: "_nsd_se_SE10");
const SE11:[]u8 @(symbol: "_nsd_se_SE11");
const SE12:[]u8 @(symbol: "_nsd_se_SE12");
const se_table:[]*u8 = [SE0, SE1, SE2, SE3, SE4, SE5, SE6, SE7, SE8, SE9, SE10, SE11, SE12];

// NSD の関数 (NSD.lib、cc65 の __fastcall__ 規約)。
// NSD 本体と BGM/SE データは ROM20 (バンク 20/21) にあるので、呼ぶときは nsd_begin / nsd_end で両スロットを切り替える
function nsd_init():void @(abi: "cc65", symbol: "_nsd_init");
function nsd_play_bgm(bgm:*u8):void @(abi: "cc65", symbol: "_nsd_play_bgm");
function nsd_stop_bgm():void @(abi: "cc65", symbol: "_nsd_stop_bgm");
function nsd_play_se(se:*u8):void @(abi: "cc65", symbol: "_nsd_play_se");
function nsd_set_master_volume(volume:u8):void @(abi: "cc65", symbol: "_nsd_set_master_volume");
function nsd_load(buf:*u8):void @(abi: "cc65", symbol: "_nsd_load");
function nsd_save(buf:*u8):void @(abi: "cc65", symbol: "_nsd_save");
function nsd_resume_bgm():void @(abi: "cc65", symbol: "_nsd_resume_bgm");
function bgm_finished():u8 @(abi: "cc65"); // sound.asm
public function main_nsd():void; // sound.asm (NMI から呼ばれる。ppu.on_vsync に設定する)

var nsd_flag:u8; // NSD の __flag のコピー (main_nsd が書く)
var jingle_wait:u8;
public var jingle_finished:u8;
public var jingle_force_finished:u8; // 強制的に、無限ループのjingleを終了するフラグ

var next_bgm_idx:u8;
public var cur_bgm_idx:u8;
var bgm_stat:u8; // 0:待機中, 1:再生中, 2: フェードアウト中, 3..6: ジングル (process_frame 参照)
var bgm_fade_wait:u8; // フェードのウェイトカウンタ
var bgm_fade_speed:u8; // フェードの速さ
var bgm_fade_count:u8; // 現在のフェードカウント

var cur_se_priority:u8;

const NSD_BUF_SIZE = 343;
var nsd_buf:[NSD_BUF_SIZE]u8;

var pbank_bak0:u8, pbank_bak1:u8; // nsd_begin 前のバンク

// NSD 呼び出しの前後: pbank 0/1 を ROM20 (SOUND_DATA) に切り替え、戻す
function nsd_begin():void
{
	pbank_bak0 = mmc3.set_pbank(0, PBANK_SOUND_DATA);
	pbank_bak1 = mmc3.set_pbank(1, PBANK_SOUND_DATA + 1);
}

function nsd_end():void
{
	mmc3.set_pbank(0, pbank_bak0);
	mmc3.set_pbank(1, pbank_bak1);
}

public function init():void
{
	nsd_begin();
	nsd_init();
	nsd_end();
	cur_bgm_idx = 0;
	next_bgm_idx = 0;
	bgm_stat = 0;
	cur_se_priority = 0;
}

public function play_bgm(idx:u8):void
{
	nsd_begin();
	nsd_play_bgm(bgm_table[idx]);
	nsd_end();
}

public function stop_bgm():void
{
	nsd_begin();
	nsd_stop_bgm();
	nsd_end();
}

function set_master_volume(volume:u8):void
{
	nsd_begin();
	nsd_set_master_volume(volume);
	nsd_end();
}

// 音を鳴らす
// priority
//  0: 消えてもいい音（発射音, 水音, ...）
//  1: ジャンプ
// 10: 優先度が高い音（ドアが開く音, ...)
// 20: 絶対に優先したい音(死亡音, コイン, ...)
public function play_se(idx:u8, priority:u8):void
{
	if (cur_se_priority > priority)
		return;
	nsd_begin();
	nsd_play_se(se_table[idx]);
	nsd_end();
	cur_se_priority = priority;
}

public function process_frame():void
{
	switch (bgm_stat) {
	//case 0:
	// DO NOTHING
	//case 1:
	// 再生中
	case 2:
		// フェードアウト
		bgm_fade_wait += 1;
		if (bgm_fade_wait >= bgm_fade_speed) {
			bgm_fade_wait = 0;
			bgm_fade_count -= 1;
			if (bgm_fade_count <= 0) {
				play_bgm(next_bgm_idx);
				cur_bgm_idx = next_bgm_idx;
				set_master_volume(15);
				bgm_stat = 1;
			} else {
				set_master_volume(bgm_fade_count);
			}
		}
	case 3:
		// jingle再生準備
		nsd_begin();
		nsd_save(&nsd_buf[0]);
		nsd_play_bgm(bgm_table[next_bgm_idx]);
		nsd_set_master_volume(15);
		nsd_end();
		bgm_stat = 4;
	case 4:
		// jingle再生中
		var finished = bgm_finished() || jingle_force_finished;
		if (finished) {
			bgm_stat = 5;
			bgm_fade_count = 0;
		}
	case 5:
		// ジングルの余韻
		bgm_fade_count += 1;
		if (bgm_fade_count >= jingle_wait) {
			nsd_begin();
			nsd_load(&nsd_buf[0]);
			nsd_resume_bgm();
			nsd_set_master_volume(0);
			nsd_end();
			bgm_fade_wait = 0;
			bgm_fade_speed = 1;
			bgm_fade_count = 0;
			bgm_stat = 6;
		}
	case 6:
		// フェードイン
		bgm_fade_wait += 1;
		if (bgm_fade_wait >= bgm_fade_speed) {
			bgm_fade_wait = 0;
			bgm_fade_count += 1;
			set_master_volume(bgm_fade_count);
			if (bgm_fade_count >= 15) {
				jingle_finished = 1;
				bgm_stat = 1;
			}
		}
	}

	if (nsd_flag & 2) {
		cur_se_priority = 0;
	}
}

public function crossfade_bgm(idx:u8, wait:u8):void
{
	next_bgm_idx = idx;
	bgm_stat = 2;
	bgm_fade_wait = 0;
	bgm_fade_speed = wait;
	bgm_fade_count = 15;
}

public function crossfade_jingle(idx:u8, wait:u16):void
{
	next_bgm_idx = idx;
	bgm_stat = 3;
	bgm_fade_wait = 0;
	bgm_fade_speed = 2;
	bgm_fade_count = 15;
	jingle_wait = wait;
	jingle_finished = 0;
	jingle_force_finished = 0;
}
