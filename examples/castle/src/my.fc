#fc 3
@(bank: 5, bss: "BSS_EX");

use * from common;
use en;
use math;
use sound;
use mem;

public const STATE_STAND = 0;
public const STATE_JUMP = 2;
public const STATE_LADDER = 3; // はしご
public const STATE_ON_ENEMY = 4;
public const STATE_DAMAGE = 5;
public const STATE_DYING = 6;
public const STATE_ON_ELEVATOR = 7; // 箱エレベーターに乗ってる
public const STATE_SWIM = 8; // 泳ぎ
public const STATE_TOUCH_EVENT = 9; // イベント中
public const STATE_FREE_MOVE = 10; // デバッグ用自由移動
public const STATE_DIE = 255;

public const SPRIDX_MY = 0;
const SPRIDX_ANCHOR = 8;

const SPR_JUMP_WALK = 0 * 4;
const SPR_JUMP_UP = 4 * 4;
const SPR_JUMP_DOWN = 6 * 4;
const SPR_PUSH = 12 * 4;
const SPR_LADDER = 14 * 4;
public const SPR_B_BUTTON = 20 * 4;
const SPR_ANCHOR = 27 * 4;

const SPR_ANCHOR_WALK = 0 * 4;
const SPR_ANCHOR_JUMP = 2 * 4;
const SPR_SWIM = 4 * 4;

public const SPR_SAVE_STAND = 8 * 4;
public const SPR_SAVE_TEXT = 14 * 4;

public var x:u8, y:u8;
public var my_anim:u8;
public var vy:i8;
public var vx:i8;
public var dir:u8;
public var state:u8;
public var state_free_move:u8; // STATE_FREE_MOVEかどうか（死んでも死なないようにするため）
public var state_free_move_transparent:u8; // STATE_FREE_MOVE中に透明かどうか
public var on_idx:u8;
public var on_x:u8;
public var on_y:u8;
public var jump_pow:u8;
public var jump_autokeep:u8; // 自動的にジャンプ継続するかどうか（たけのこジャンプで使われる）
public var prev_in_water:u8;
public var wait:u8;
public var last_checkpoint:u8;
public var coin_num:u8; // コインの数
public var has_anchor:u8; // 錨を持ってるかどうか
public var in_water_surface:u8; // 水面にいるかどうか(背面スプライトにするため)
public var anim_stat:u8; // アニメーション状態
public var jump_mask:u8; // ジャンプボタン
public var swim_keep_velocity:u8; // 泳ぎ中に上方向の速度を制限しない(水流ジェットが利用)

public var anchor_area:u8;
public var anchor_x:u8;
public var anchor_y:u8;
public var anchor_vx:i8;
public var anchor_vy:i8;
var anchor_stat:u8;
public var anchor_wait:u8;

public var grobe_progress:u8; // グローブの押している時間

public var touch_event_func:farfn():u8; // 予約されているタッチイベント
public var touch_event_func_activated:farfn():u8; // 現在実行中のタッチイベント
public var touch_event_x:u8; // タッチイベントのマーカーの表示場所
public var touch_event_y:u8;
public var touch_event_stat:u8; // タッチイベントの状態
public var touch_event_wait:u8; // タッチイベントのウェイト
public var touch_event_p1:u8; // タッチイベントのパラメータ
public var touch_event_p2:u8;

public var watch_used:u8; // 懐中時計を使用済みかどうか
public var watch_in_area:u8; // 懐中時計がこの画面にあるか

public const ITEM_MAX = 64;
public var items:[ITEM_MAX]u8 @(segment: "BSS_EX");
public const FLAG_MAX = 32;
public const FLAG_WATERGATE = 31;
public const FLAG_COLORSWITCH = 30;
public const FLAG_REVEAL_TEMPLE_OF_SUN = 29;
public const FLAG_MAGMAGATE = 28; // マグマを消火する
public const FLAG_ANCHOR_GENERATOR = 27; // 錨生成器
public const FLAG_SUNGATE = 26; // 太陽神殿のゲート(1:太陽, 2:月, 4:星のビットフラグ)
public const FLAG_SOUL_GATE = 25; // 魂のゲートの所持魂（6bitのビットフラグ）
public var flags:[FLAG_MAX]u8 @(segment: "BSS_EX");
public const MAP_FLAG_MAX = 64;
public var map_flag:[MAP_FLAG_MAX]u8 @(segment: "BSS_EX");
public const MAP_COIN_MAX = 64;
public var map_coin:[MAP_COIN_MAX / 8]u8 @(segment: "BSS_EX");
public const SUBTEXT_FLAG_MAX = 16;
public var subtext_flags:[SUBTEXT_FLAG_MAX / 8]u8 @(segment: "BSS_EX");
public const MEMORY_FLAG_MAX = 128;
public var memory_flags:[MEMORY_FLAG_MAX / 8]u8 @(segment: "BSS_EX");
public var memory_read_flags:[MEMORY_FLAG_MAX / 8]u8 @(segment: "BSS_EX");
public const CHECKPOINT_FLAG_MAX = 16;
public var checkpoint_flags:[CHECKPOINT_FLAG_MAX]u8 @(segment: "BSS_EX");

public const STATISTICS_BASE = 234; // savedata.data[]のSTATISTICSの始まるインデックス
public const STATISTICS_DEAD_COUNT = STATISTICS_BASE + 0; // 死んだ数（最大255)

const ANIM_STAT_NONE = 0;
public const ANIM_STAT_PUSH = 1;

public function init():void @(segment: "game")
{
	anim_stat = 0;
	if (debug_flag & DEBUG_FLAG_UP_JUMP) {
		jump_mask = pad.A | pad.UP;
	} else {
		jump_mask = pad.A;
	}
	swim_keep_velocity = 0;
	state_free_move = 0;
	state_free_move_transparent = 0;
}

public use boxelev;
use my_process;

public function clear_sprites():void @(segment: "game")
{
	ppu.clear_sprite2_idx(SPRIDX_MY);
	ppu.clear_sprite2_idx(SPRIDX_ANCHOR);
}

public function process():void
{
	my_process.process();
}

public function draw():void @(segment: "game")
{
	if (state_free_move_transparent) {
		clear_sprites();
		return;
	}

	var a:u8;
	var dir_flag = 64 * dir;
	var in_water = (bg.cell(x, y) == 24);
	if (has_anchor) {
		// 錨を持ってる
		switch (state) {
		case STATE_STAND, STATE_ON_ENEMY, STATE_ON_ELEVATOR, STATE_FREE_MOVE:
			a = my_anim / 8 % 2;
			ppu.cbank2 = CBANK_MY + 1;
			gr_sprite2_idx(x, y, SPR_ANCHOR_WALK + a * 4, dir_flag, SPRIDX_MY);
			gr_sprite2_idx(x, y - 12, SPR_ANCHOR, 0, SPRIDX_ANCHOR);
		case STATE_JUMP, STATE_DAMAGE:
			a = anim / 8 % 2;
			ppu.cbank2 = CBANK_MY + 1;
			gr_sprite2_idx(x, y, SPR_ANCHOR_JUMP, dir_flag, SPRIDX_MY);
			gr_sprite2_idx(x, y - 12, SPR_ANCHOR, 0, SPRIDX_ANCHOR);
		case STATE_LADDER:
			a = (my_anim / 4) % 8;
			dir_flag = [0, 0, 0, 0, 64, 64, 64, 64][a];
			a = [4, 0, 0, 4, 4, 0, 0, 4][a];
			ppu.cbank2 = CBANK_MY;
			gr_sprite2_idx(x, y, SPR_LADDER + a, dir_flag, SPRIDX_MY);
			gr_sprite2_idx(x, y - 4 - my_anim / 2 % 4, SPR_ANCHOR, 0, SPRIDX_ANCHOR);
		case STATE_DYING:
			if (anim % 2) {
				ppu.cbank2 = CBANK_MY;
				gr_sprite2_idx(x, y, 8 * 4 + wait / 32 * 4, dir_flag, SPRIDX_MY);
			} else {
				ppu.clear_sprite2_idx(SPRIDX_MY);
			}
		}
	} else {
		// 錨を持ってない
		switch (state) {
		case STATE_STAND, STATE_ON_ENEMY, STATE_ON_ELEVATOR, STATE_FREE_MOVE:
			switch (anim_stat) {
			case ANIM_STAT_NONE:
				const ANIM = [1, 2, 3, 3, 2, 1, 0, 0];
				a = ANIM[my_anim / 4 % 8];
				ppu.cbank2 = CBANK_MY;
				gr_sprite2_idx(x, y, a * 4, dir_flag, SPRIDX_MY);
			case ANIM_STAT_PUSH:
				ppu.cbank2 = CBANK_MY;
				a = my_anim / 16 % 2;
				gr_sprite2_idx(x, y, SPR_PUSH + a * 4, dir_flag, SPRIDX_MY);
			}

		case STATE_JUMP, STATE_DAMAGE:
			a = anim / 8 % 2 * 4;
			if (in_water)
				dir_flag = dir_flag | 32;
			if (vy < -8) {
				ppu.cbank2 = CBANK_MY;
				gr_sprite2_idx(x, y, SPR_JUMP_UP, dir_flag, SPRIDX_MY);
			} else
				if (vy < 8) {
					ppu.cbank2 = CBANK_MY;
					gr_sprite2_idx(x, y, SPR_JUMP_UP + 4, dir_flag, SPRIDX_MY);
				} else {
					ppu.cbank2 = CBANK_MY;
					gr_sprite2_idx(x, y, SPR_JUMP_DOWN + a, dir_flag, SPRIDX_MY);
				}

		case STATE_LADDER:
			a = (my_anim / 4) % 8;
			dir_flag = [0, 0, 0, 0, 64, 64, 64, 64][a];
			a = [4, 0, 0, 4, 4, 0, 0, 4][a];
			ppu.cbank2 = CBANK_MY;
			gr_sprite2_idx(x, y, SPR_LADDER + a, dir_flag, SPRIDX_MY);

		case STATE_SWIM:
			a = (my_anim / 16) % 2;
			ppu.cbank2 = CBANK_MY + 1;
			var flag = 0;
			var dy:i8 = 0;
			if (in_water_surface) {
				flag = ppu.SPRITE_FLAG_HIDE;
				dy = math.sin(anim * 8) / 64;
			}
			gr_sprite2_idx(x, y + 4 + dy, SPR_SWIM + a * 4, dir_flag | flag, SPRIDX_MY);

		case STATE_DYING:
			if (anim % 2) {
				ppu.cbank2 = CBANK_MY;
				gr_sprite2_idx(x, y, 8 * 4 + wait / 32 * 4, dir_flag, SPRIDX_MY);
			} else {
				ppu.clear_sprite2_idx(SPRIDX_MY);
			}
		}

		ppu.clear_sprite2_idx(SPRIDX_ANCHOR);
	}
}

public function get_map(x:u8, y:u8):u8 @(segment: "game")
{
	var idx = y * 2 + x / 8;
	var n = map_flag[idx];
	var cx = 7 - x % 8;
	return n & (1 << cx);
}

public function set_map(x:u8, y:u8):void @(segment: "game")
{
	var idx = y * 2 + x / 8;
	var n = map_flag[idx];
	var cx = 7 - x % 8;
	map_flag[idx] = n | (1 << cx);
}

public function create_anchor(x:u8, y:u8):void @(segment: "en3")
{
	has_anchor = 0;
	anchor_area = bg.cur_area;
	anchor_x = x;
	anchor_y = y;
	anchor_vx = 0;
	anchor_vy = 0;
	anchor_stat = 0;
	anchor_wait = 0;
}

public function anchor_event():u8
{
	has_anchor = 1;
	state = STATE_STAND;
	return 1;
}

public function has_memory(i:u8):u8 @(segment: "common")
{
	return memory_flags[i / 8] & BIT_MASK[i % 8];
}

public function set_memory(i:u8):void @(segment: "game")
{
	memory_flags[i / 8] = memory_flags[i / 8] | BIT_MASK[i % 8];
}

public function clear_memory(i:u8):void @(segment: "game")
{
	memory_flags[i / 8] = memory_flags[i / 8] & (BIT_MASK[i % 8] ^ 0xff);
	memory_read_flags[i / 8] = memory_read_flags[i / 8] & (BIT_MASK[i % 8] ^ 0xff);
}

public function is_memory_read(i:u8):u8 @(segment: "game")
{
	return memory_read_flags[i / 8] & BIT_MASK[i % 8];
}

public function set_memory_read(i:u8):void @(segment: "game")
{
	memory_read_flags[i / 8] = memory_read_flags[i / 8] | BIT_MASK[i % 8];
}

public function register_touch_event(f:farfn():u8, x:u8, y:u8, p1:u8 = 0):void @(inline)
{
	touch_event_func = f;
	touch_event_x = x;
	touch_event_y = y;
	touch_event_p1 = p1;
}
