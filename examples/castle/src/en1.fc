use * from en;
use * from graphics;
use ppu;
use my;
use savedata;

/*********************************************
 * ダミー
 *********************************************/
public function none_new(i:int):void {}
public function none_process(i:int):void {}

/*********************************************
 * ウィルオーウィスプ
 *********************************************/

function wow_new(i : int) : void
{
}

function wow_process(i : int) : void
{
	var slot = pslot[i];
	var x = px[i];
	var y = py[i];
	var dir = p1[i];
	var speed = p2[i];

	var n = (speed + giff) / 16;
	while (n)
	{
		var vx = DIR_VX[dir];
		var vy = DIR_VY[dir];
		var xbias = 0;
		if (vx < 0)
		{
			xbias = -1;
		}
		var ybias = 0;
		if (vy < 0)
		{
			ybias = -1;
		}
		if (y >= 240 || y < 16)
		{
			type[i] = 0;
			return;
		}
		if (bg.cell_type(x + vx * 8 + xbias, y + vy * 8 + ybias) & bg.TYPE_STOP || check_outside(x, y))
		{
			dir = (2 + dir) % 4;
		}
		x += DIR_VX[dir];
		y += DIR_VY[dir];

		var cx = x % 16;
		var cy = y % 16;
		if (x % 16 == 8 && y % 16 == 8)
		{
			var c = bg.cell(x, y);
			if (c >= 4 && c < 8)
			{
				dir = c - 4;
			}
		}

		n -= 1;
	}

	gr_sprite2(x + math.rand() % 4 - 2, y + math.rand() % 4 - 2, SPR_WOW + (anim / 4) % 2 * 4, 1 + anim % 2);

	px[i] = x;
	py[i] = y;
	p1[i] = dir;

	check_hit(i, 8);
}

/*********************************************
 * エレベーター
 *********************************************/
function elevator_new(i : int) : void
{
	if (p2[i] == 0)
	{
		p2[i] = 8;
	}
	if (p3[i] == 0)
	{
		px[i] += 8;
	}
}

function elevator_process(i : int) : void
{
	var x = px[i];
	var y = py[i];
	var dir = p1[i];
	var speed = p2[i];

	var n = (speed + giff) / 16;
	while (n)
	{
		var vx = DIR_VX[dir];
		var vy = DIR_VY[dir];
		var size : int;
		if (p3[i] == 1)
		{
			size = vx * 8;
		}
		else
		{
			size = vx * 16;
		}
		if (bg.cell_type(x + size, y + vy * 8) & bg.TYPE_STOP || check_outside(x, y))
		{
			dir = (2 + dir) % 4;
		}
		x += vx;
		y += vy;

		n -= 1;
	}

	if (p3[i] == 1)
	{
		ppu.sprite(x - 8, y - 8, SPR_ELEVATOR, 0);
		ppu.sprite(x, y - 8, SPR_ELEVATOR, 64);
	}
	else
	{
		gr_sprite2(x - 8, y, SPR_ELEVATOR, 0);
		gr_sprite2(x + 8, y, SPR_ELEVATOR, 64);
	}

	px[i] = x;
	py[i] = y;
	p1[i] = dir;
}

/*********************************************
 * 水の中の泡
 *********************************************/
function bubble_new(i : int) : void { }

function bubble_process(i : int) : void
{
	var x = px[i];
	var y = py[i];

	x = x + math.rand() / 128 * 2 - 1;
	y = y - (giff / 8);

	ppu.sprite(x - 4, y - 8, SPR_BUBBLE, 1);

	if (py[i] < 16 || (bg.cell_type(x, y - 8) & bg.TYPE_WATER) == 0)
	{
		type[i] = 0;
	}

	px[i] = x;
	py[i] = y;
}

/*********************************************
 * 水に入った時の飛沫
 *********************************************/
function splash_new(i : int) : void { }

function splash_process(i : int) : void
{
	var x = px[i];
	var y = py[i];
	var life = p1[i];

	if (anim % 2)
	{
		ppu.sprite(x-12+life/2, y-16, SPR_SPLASH  , 1 | ppu.SPRITE_FLAG_HIDE);
		ppu.sprite(x+4-life/2, y-16, SPR_SPLASH+2, 1 | ppu.SPRITE_FLAG_HIDE);
		//gr_sprite2(x - 4, y - 8, SPR_SPLASH, 1 | ppu.SPRITE_FLAG_HIDE);
	}

	if (life)
	{
		life -= 1;
	}
	else
	{
		type[i] = 0;
	}

	y += (8+giff)/16;

	py[i] = y;
	p1[i] = life;
}

/*********************************************
 * 押せる岩
 * p1: 方向
 * p2: 保存されたマス
 * p3: ウェイト
 * p4: 状態
 * p5: vy;
 *********************************************/
function block_new(i : int) : void
{
	/*
	MEMO: バンクの関係で使えないので、my.do_grobe()にベタ書きしてる
	p2[i] = 0;
	p3[i] = 0;
	p4[i] = 0;
	*/
}

function block_process(i : int) : void
{
	var x = px[i];
	var y = py[i];
	var dir = p1[i];
	var wait = p3[i];
	var stat = p4[i];
	var vy = p5[i];

	switch( stat ){
	case 0:
		// 左右に動く
		if( wait == 0 ){
			var c = bg.blank_cell;
			if (bg.cur_area == 13 + 4 * MAP_WIDTH){
				// 例外：塔の中は黒く塗る
				c = 0;
			}elsif (bg.cur_area == 7 + 2 * MAP_WIDTH){
				// 例外：空は空で塗る
				c = 15;
			} 
			bg.put2(x / 16, y / 16, c, 3);
		}
		wait += 1;
		x += DIR_VX[dir];

		gr_sprite2(x,y, SPR_BLOCK, 1);
		
		if( wait >= 16 ){
			stat = 1;
			wait = 0;
			vy = 8;
		}
	case 1:
		// 落下
		if (y >= 240){
			type[i] = 0;
		}else{
			vy += 8;
			y += (giff+vy) / 16;
			if( vy >= 32 ){ 
				vy = 32;
			}
		}

		if( bg.cell_type(x,y+8) & bg.TYPE_WALL != 0){
			y = (y+8)/16*16 - 8;
			stat = 2;
		}

		gr_sprite2(x,y, SPR_BLOCK, 1);
	case 2:
		bg.put2(x / 16, y / 16, bg.TILE_MOVABLE_BLOCK, 0);
		type[i] = 0;
	}


	px[i] = x;
	py[i] = y;
	p1[i] = dir;
	p3[i] = wait;
	p4[i] = stat;
	p5[i] = vy;
}

/*********************************************
 * カエル
 *********************************************/
function frog_new(i : int) : void
{
	if (p3[i] == 0)
	{
		p3[i] = 32;
	}
	p4[i] = 0;
	p5[i] = 30;
}

function frog_process(i : int) : void
{
	var slot = pslot[i];
	var x = px[i];
	var y = py[i];
	var dir = p1[i];
	var speed = p2[i];
	var pow = p3[i];
	var state = p4[i];
	var t : sint = p5[i];
	var anim = 0;

	switch (state)
	{
	case 0:
		// stand
		if (t)
		{
			t -= 1;
		}
		else
		{
			state = 1;
			t = -pow;
		}
	case 1:
		// jump
		y += (t + giff) / 16;
		var vx = (pow / 4 + giff) / 16;
		if (dir == 1)
		{
			x += vx;
		}
		else
		{
			x -= vx;
		}
		t += 1;
		var hit = check_block(&x, &y);
		if (hit & (DIR_MASK_RIGHT | DIR_MASK_LEFT))
		{
			dir = 4 - dir;
		}
		if (hit & DIR_MASK_DOWN)
		{
			state = 0;
			t = 30;
		}
		if (hit & DIR_MASK_UP)
		{
			t = 0;
		}

		if (check_outside(x, y))
		{
			type[i] = 0;
			return;
		}
	}

	gr_sprite2(x, y, SPR_SLOT[slot] + SPR_FROG + state * 4, PAL_SLOT[slot] | DIR_FLIP_XY[dir]);

	px[i] = x;
	py[i] = y;
	p1[i] = dir;
	p4[i] = state;
	p5[i] = t;

	check_hit(i, 8);
}

/*********************************************
 * クッキー
 *********************************************/
function cookie_new(i : int) : void
{
	if (p3[i] == 0)
	{
		p3[i] = 2;
	}
	p4[i] = px[i];
	p5[i] = py[i];
}

function cookie_process(i : int) : void
{
	var x = px[i];
	var y = py[i];
	var angle = p1[i];
	var speed = p2[i];
	var size = p3[i];

	angle += speed;
	x = p4[i] + (math.cos(angle) >> size);
	y = p5[i] + (math.sin(angle) >> size);

	gr_sprite2(x + math.rand() % 4 - 2, y + math.rand() % 4 - 2, SPR_WOW + (anim / 4) % 2 * 4, anim % 2);

	px[i] = x;
	py[i] = y;
	p1[i] = angle;

	check_hit(i, 8);
}

/*********************************************
 * 宝箱
 *********************************************/
public function has_coin(i:int):int{
	return my.map_coin[i/8] & BIT_MASK[i%8];
}

public function set_coin(i:int):void{
	my.map_coin[i/8] = my.map_coin[i/8] | BIT_MASK[i%8];
	my.coin_num += 1;
}

function chest_new(i : int) : void
{
	var item_id = p1[i];
	var coin_id = p2[i];
	if( item_id == ITEM_ID_COIN){
		if( has_coin(coin_id) )
		{
			type[i] = 0;
		}
	} else {
		if (my.items[item_id])
		{
			type[i] = 0;
		}
	}
}

function chest_process(i : int) : void
{
	var item_id = p1[i];
	var x = px[i];
	var y = py[i];

	if (math.abs(my.x - x) < 16 && math.abs(my.y - y) < 16)
	{
		my.touch_event_func = chest_event;
		my.touch_event_p1 = i;
		my.touch_event_x = x;
		my.touch_event_y = y;
	}

	var is_great = (item_id >= 12 && item_id <= 17);
	if( item_id == ITEM_ID_COIN){
		ppu.sprite(x-4, y-8, SPR_CHEST_COIN, 0);
	}else{
		gr_sprite2(x, y, SPR_CHEST, is_great);
	}
}

function chest_event():int options(segment:my)
{
	var old_pbank = mmc3.set_pbank(0, PBANK_EN1);
	var result = _chest_event();
	mmc3.set_pbank(0, old_pbank);
	return result;
}

function _chest_event():int
{
	var i = my.touch_event_p1;
	switch(my.touch_event_stat){
	case 0:
		// 初期化
		ppu.cbank2 = my.CBANK_MY+2;
		ppu.clear_sprite2_idx(my.SPRIDX_MY);
		my.touch_event_stat = 1;
		my.touch_event_wait = 0;
		my.touch_event_x = px[i];
		my.touch_event_y = py[i];
		my.touch_event_p1 = p1[i];
		my.touch_event_p2 = p2[i];
		type[i] = 0;
		return _chest_event();
	case 1:
		// 宝箱を開く
		my.touch_event_wait += 1;
		var is_great = (i >= 12 && i <= 17);

		var a = 0;;
		if( my.touch_event_wait > 8 && my.touch_event_wait < 52 ) a = 1;
		gr_sprite2_idx( my.x, my.y, SPR_EVENT_CHEST_STAND+a*4, 0, my.SPRIDX_MY);

		if( my.touch_event_wait <= 50 ){
			if( i == ITEM_ID_COIN){
				a = (my.touch_event_wait / 4)%4;
				ppu.sprite(my.touch_event_x - 4, my.touch_event_y - 8 - my.touch_event_wait/2, SPR_EVENT_CHEST_COIN_OPEN + a*2, 0);
				if( my.touch_event_wait == 10 ) sound.play_se(sound.SE_COIN,20);
			}else{
				a = my.touch_event_wait / 10;
				if( a > 2 ) a = 2;
				gr_sprite2(my.touch_event_x, my.touch_event_y, SPR_EVENT_CHEST_OPEN + a*4, is_great);
			}
		}

		if( my.touch_event_wait >= 50 ){
			chest_get_item();
			my.touch_event_stat = 2;
		}
	case 2:
		return 1;
	}
	return 0;
}

function chest_get_item():void
{
	var item_id = my.touch_event_p1;
	var coin_id = my.touch_event_p2;
	var has_event = 0;

	if(item_id == ITEM_ID_COIN){
		if( my.items[item_id] == 0 ){
			has_event = 1;
		}
		set_coin(coin_id);
		my.items[ITEM_ID_COIN] = 1;
		if( my.items[ITEM_ID_WALLET] ){
			savedata.save_coins();
		}
	}else{
		my.items[item_id] = 1;
		has_event = 1;
	}

	if( has_event ){
		game_event = event.ID_GET_ITEM;
		game_event_p1 = item_id;
	}
}

/*********************************************
 * ランプの灯火
 *********************************************/
function lamp_new(i : int) : void
{
}

function lamp_process(i : int) : void
{
	var slot = pslot[i];
	if (my.items[ITEM_ID_LAMP])
	{
		gr_sprite2(px[i], py[i] + 4, SPR_SLOT[slot] + SPR_LAMP + (anim / 4) % 4 * 4, PAL_SLOT[slot]);
	}
	else
	{
		type[i] = 0;
	}
}

/*********************************************
 * ガスさん
 *********************************************/
function gas_new(i : int) : void
{
}

function gas_process(i : int) : void
{
	var slot = pslot[i];
	var x = px[i];
	var y = py[i];
	var dir = p1[i];
	var speed = p2[i];

	var n = (speed + giff) / 16;
	while (n)
	{
		var vx = DIR_VX[dir];
		var vy = DIR_VY[dir];
		var xbias = 0;
		if (vx < 0)
		{
			xbias = -1;
		}
		var ybias = 0;
		if (vy < 0)
		{
			ybias = -1;
		}
		if (y >= 240 || y < 16)
		{
			type[i] = 0;
			return;
		}
		if (bg.cell_type(x + vx * 8 + xbias, y + vy * 8 + ybias) & bg.TYPE_STOP || check_outside(x, y))
		{
			dir = (2 + dir) % 4;
		}
		x += DIR_VX[dir];
		y += DIR_VY[dir];

		var cx = x % 16;
		var cy = y % 16;
		if (x % 16 == 8 && y % 16 == 8)
		{
			var c = bg.cell(x, y);
			if (c >= 4 && c < 8)
			{
				dir = c - 4;
			}
		}

		n -= 1;
	}

	gr_sprite2(x + math.sin(anim * 8) / 64, y + math.cos(anim * 8) / 64, SPR_SLOT[slot] + SPR_GAS + (anim / 8) % 2 * 4, PAL_SLOT[slot]);

	px[i] = x;
	py[i] = y;
	p1[i] = dir;

	if (!my.items[ITEM_ID_GAS_MASK])
	{
		check_hit(i, 8);
	}
}

/*********************************************
 * ゴースト
 *********************************************/

function ghost_new(i : int) : void
{
	if (p1[i] == 0)
	{
		p1[i] = 30;
	}
	p3[i] = 0;
	p4[i] = math.rand() / 2;
}

function ghost_process(i : int) : void
{
	var x = px[i];
	var y = py[i];
	var state = p3[i];
	var wait = p4[i];
	var angle = p5[i];

	var dy : int;
	var dir = 0;
	if ((angle - 64) < 128)
	{
		dir = 64;
	}

	switch (state)
	{
	case 0:
		dy = y + math.sin(wait * 4) / 16;
		if (wait)
		{
			wait -= 1;
		}
		else
		{
			angle = math.atan(my.y / 16 - y / 16, my.x / 16 - x / 16);
			state = 1;
			wait = p1[i];
			if (my.items[ITEM_ID_OMAMORI])
			{
				wait = wait * 2;
			}
		}
	case 1:
		if (my.items[ITEM_ID_OMAMORI])
		{
			x += (math.cos(angle) / 8 + giff) / 16;
			y += (math.sin(angle) / 8 + giff) / 16;
		}
		else
		{
			x += (math.cos(angle) / 4 + giff) / 16;
			y += (math.sin(angle) / 4 + giff) / 16;
		}
		dy = y;
		if (wait)
		{
			wait -= 1;
		}
		else
		{
			state = 0;
			wait = 64;
		}
	}

	if (anim % 2)
	{
		var slot = pslot[i];
		gr_sprite2(x, dy, SPR_SLOT[slot] + SPR_GHOST + ((anim / 8) % 2) * 4, dir | PAL_SLOT[slot]);
	}

	px[i] = x;
	py[i] = y;
	p3[i] = state;
	p4[i] = wait;
	p5[i] = angle;

	check_hit(i, 8);
}

/*********************************************
 * スイッチ
 *********************************************/

function switch_new(i : int) : void
{
	p2[i] = py[i];
}

function switch_process(i : int) : void
{
	var x = px[i];
	var y = py[i];
	var flag_num = p1[i];

	if (my.state == my.STATE_ON_ENEMY && my.on_idx == i)
	{
		if (y < p2[i] + 8)
		{
			y += 1;
		}
		my.flags[flag_num] = 1;
	}
	else
	{
		if (y > p2[i])
		{
			y -= 1;
		}
	}

	ppu.sprite(x - 8, y - 8, SPR_ELEVATOR, 0);
	ppu.sprite(x, y - 8, SPR_ELEVATOR, 64);

	px[i] = x;
	py[i] = y;
}

/*********************************************
 * 開閉扉スイッチ
 *********************************************/

function flaged_door_new(i : int) : void
{
	p2[i] = my.flags[p1[i]];
	p3[i] = 1;
}

function flaged_door_process(i : int) : void
{
	var x = px[i];
	var y = py[i];
	var flag_num = p1[i];
	var old_flag = p2[i];
	var flag = my.flags[flag_num];

	if (p3[i])
	{
		flaged_door_redraw(px[i], py[i], p2[i]);
		p3[i] = 0;
	}

	if (old_flag != flag)
	{
		sound.play_se(sound.SE_OPEN_DOOR,10);
		flaged_door_redraw(x, y, flag);
		p2[i] = flag;
	}
}

function flaged_door_redraw(x : int, y : int, flag : int) : void
{
	if (flag)
	{
		bg.put2(x / 16, y / 16, bg.blank_cell_by_door, bg.tile_pal[bg.blank_cell_by_door]);
		bg.put2(x / 16, y / 16 + 1, bg.blank_cell_by_door, bg.tile_pal[bg.blank_cell_by_door]);
	}
	else
	{
		bg.put2(x / 16, y / 16, 38, 0);
		bg.put2(x / 16, y / 16 + 1, 38, 0);
	}
}

/*********************************************
 * 無限湧きポイント
 *********************************************/

function portal_new(i : int) : void
{
	p5[i] = 0;
}

function portal_process(i : int) : void
{
	var slot = pslot[i];
	var x = px[i];
	var y = py[i];
	var freq = p3[i];
	var rest = p5[i];
    var spr = SPR_SLOT[slot] + SPR_PORTAL;
    var pal = PAL_SLOT[slot];

	if (anim % 64 == 0)
	{
		if (rest)
		{
			rest -= 1;
		}
		else
		{
			var n = new ();
			if (n != -1)
			{
				type[n] = p4[i];
				pslot[n] = slot;
				px[n] = x;
				py[n] = y;
				p1[n] = p1[i];
				p2[n] = p2[i];
				p3[n] = 0;
				p4[n] = 0;
				setup(n);
			}
			rest = freq;
		}
	}

	if (rest == 0)
	{
		gr_sprite2(x, y, spr + anim / 4 % 2 * 4, pal);
	}

	p5[i] = rest;
}

/*********************************************
 * チェックポイント
 *********************************************/

function checkpoint_new(i : int) : void
{
	p4[i] = 0;
}

function checkpoint_process(i : int) : void
{
	var slot = pslot[i];
	var x = px[i];
	var y = py[i];
	var noslot = p2[i];
	var nosave = p3[i];
	var stat = p4[i];
	var wait = p5[i];

	switch (stat)
	{
	case 0:
		// タッチ判定
		if (!nosave && math.abs(x - my.x) < 12 && math.abs(y - my.y) < 12)
		{
			my.touch_event_func = checkpoint_event;
			my.touch_event_p1 = i;
			my.touch_event_x = x;
			my.touch_event_y = y-16;
		}
	case 1:
		// セーブ演出
		wait += 1;
		if (wait > 60)
		{
			stat = 0;
		}
		if (anim % 2)
		{
			gr_sprite2(x - 8, y - 12 - wait / 4, my.SPR_SAVE_TEXT + 0, 2);
			gr_sprite2(x + 8, y - 12 - wait / 4, my.SPR_SAVE_TEXT + 4, 2);
		}
	}

	if( !noslot) {
		gr_sprite2(x, y-16, SPR_SLOT[slot] + SPR_CHECKPOINT, PAL_SLOT[slot] );
		gr_sprite2(x, y   , SPR_SLOT[slot] + SPR_CHECKPOINT + 4, PAL_SLOT[slot] );
	}

	p4[i] = stat;
	p5[i] = wait;
}

function checkpoint_event():int options(segment:my)
{
	var old_pbank = mmc3.set_pbank(0, PBANK_EN1);
	var result = _checkpoint_event();
	mmc3.set_pbank(0, old_pbank);
	return result;
}

function _checkpoint_event():int
{
	var i = my.touch_event_p1;
	var x = px[i];
	var y = py[i];

	switch(my.touch_event_stat){
	case 0:
		ppu.cbank2 = my.CBANK_MY+1;
		ppu.clear_sprite2_idx(my.SPRIDX_MY);
		my.touch_event_stat = 1;
		my.touch_event_wait = 0;
		p4[i] = 1;
		p5[i] = 0;
		sound.play_se(sound.SE_SAVEPOINT,20);
		return _checkpoint_event();
	case 1:
		my.touch_event_wait += 1;
		var a = 0;;
		if( my.touch_event_wait > 8 && my.touch_event_wait < 52 ) a = 1;
		gr_sprite2( my.x, my.y, my.SPR_SAVE_STAND+a*4, 0);
		if( my.touch_event_wait >= 62 ){
			my.touch_event_stat = 2;
		}
	case 2:
		my.last_checkpoint = p1[i];
		my.checkpoint_flags[p1[i]] = 1;
		my.watch_used = 0;
		savedata.save();
		return 1;
	}
	return 0;
}

/*********************************************
 * チェックポイントのスロット未使用版
 *********************************************/
function checkpoint_noslot_new(i : int) : void
{
	checkpoint_new(i);
}

function checkpoint_noslot_process(i : int) : void {
	checkpoint_process(i);
}
