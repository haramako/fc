#fc 2
// A: CRC-16/XMODEM (多項式 0x1021、テーブル無し)。c-bench-64 の crc16.c と同じ処理を 8192 バイトに
// (データは crc8 と同じ擬似乱数バッファ)。16 ビット値のシフト・XOR・比較のループ。
use * from stdio;

const LEN:int16 = 8192;
var buf:[8192]int options(segment: "BSS_EX");

function crc16(p:*int, length:int16):int16
{
	var crc:int16 = 0;
	var i:int16;
	for (i = 0; i < length; i++) {
		crc ^= (*p as int16) << 8;
		for (var j = 8; j; j--) {
			if (crc & 0x8000) {
				crc = (crc << 1) ^ 0x1021;
			} else {
				crc = crc << 1;
			}
		}
		p += 1;
	}
	return crc;
}

function fill():void
{
	var p = buf as *int;
	var x:int16 = 0x1234;
	var i:int16;
	for (i = 0; i < LEN; i++) {
		x = x * 5 + 0x3d;
		*p = (x >> 8) as int;
		p += 1;
	}
}

function main():void
{
	fill();
	bench_start();
	var crc = crc16(buf, LEN);
	bench_end();
	printf("crc16=", crc, "\n");
	exit(0);
}
