#fc 2
// A: エラトステネスの篩。c-bench-64 (thred/c-bench-64) の sieve.c と同じアルゴリズム・同じ規模
// (8191 個のバイトフラグで 1〜16384 の素数を数える。10 回繰り返す。答え 1900) なので、公開されている
// 他のコンパイラの秒数 (C64 ≒ 1 MHz) と比べられる。添字が 1 バイトなのでポインタを進めて触る。
use * from stdio;

const SIZE:int16 = 8191;
var flags:[8191]int options(segment: "BSS_EX");

function sieve():int16
{
	var count:int16 = 1;
	var p = flags as *int;
	var i:int16;
	for (i = 0; i < SIZE; i++) {
		*p = 1;
		p += 1;
	}
	p = flags as *int;
	for (i = 0; i < SIZE; i++) {
		if (*p) {
			var prime = i + i + 3;
			var k = i + prime;
			var q = p;
			q += prime;
			while (k < SIZE) {
				*q = 0;
				q += prime;
				k += prime;
			}
			count++;
		}
		p += 1;
	}
	return count;
}

function main():void
{
	var count:int16 = 0;
	bench_start();
	for (var n = 0; n < 10; n++) {
		count = sieve();
	}
	bench_end();
	printf("count=", count, "\n");
	exit(0);
}
