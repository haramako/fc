#fc 2
options(bank: 23);
//use stdio;

// 
// メモリブロックの先頭に以下を含む
// [tag ...]
// tag = flag << 8 | size
// flag = 0=フリー, 1:確保済み
// size = メモリサイズ/4 (tagの1byteを含む)
//
var buf:[256]int options(segment: "BSS_EX");

const MASK_FLAG = 0x80;
const MASK_SIZE = 0x7f;
const TAG_FREE = 0x00;
const TAG_USED = 0x80;

public function init():void
{
	buf[0] = 0 | 63;
}

public function alloc(size:int):*int
{
	var cur = &buf[0];
	var tail = cur + 252;
	var need_size = (size + 1 /*tag分*/ + 3 /*ceil分*/ ) / 4;
	while (1) {
		var tag = *cur;
		var tag_flag = tag & MASK_FLAG;
		var tag_size = tag & MASK_SIZE;
		if (tag_flag == TAG_FREE && tag_size >= need_size) {
			var new_tag = TAG_USED | need_size;
			*cur = new_tag;
			var next = cur + (need_size * 4);
			if (tag_size > need_size) {
				var next_tag = TAG_FREE | (tag_size - need_size);
				*next = next_tag;
			}
			return cur + 1;
		} else {
			cur = cur + tag_size * 4;
			if (cur >= tail) {
				asm(".byte 2"); // 不正命令で止める
				return bitcast<*int>(0);
			}
		}
	}
}

public function release(addr:*int):int
{
	var cur = &buf[0];
	var prev = bitcast<*int>(0);
	var tail = cur + 252;
	while (1) {
		var tag = *cur;
		var tag_flag = tag & MASK_FLAG;
		var tag_size:uint8 = tag & MASK_SIZE;
		if (cur + 1 == addr) {
			var next = cur + (tag_size * 4);
			var next_tag = *next;
			var next_flag = next_tag & MASK_FLAG;
			var next_size = next_tag & MASK_SIZE;

			// 後続ブロックをつなげる
			if (next_tag == TAG_FREE) {
				tag_size += next_size;
			}

			// 前ブロックがあるか
			if (prev) {
				var prev_tag = *prev;
				var prev_flag = prev_tag & MASK_FLAG;
				var prev_size = prev_tag & MASK_SIZE;
				if (prev_tag == TAG_FREE) {
					// 前ブロックとつなげる
					tag_size += prev_size;
					cur = prev;
				}
			}

			*cur = TAG_FREE | tag_size;
			return 1;
		} else {
			prev = cur;
			cur = cur + tag_size * 4;
			if (cur >= tail) {
				return 0;
			}
		}
	}
}
