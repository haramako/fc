#fc 2
options(bank: 10, bss: "BSS_EX");

use * from common;
use event;
use mem;
use my;
use game;
use sound;
use text;
use ppu;
use irqcmd;

//=================================================
// 商人
//=================================================

struct MarchantEvent {
	kind:uint8;

	text:*uint8;
	idx_base:uint8;
}

alias m:MarchantEvent = event.shared_work;

const MARCHANT_PALETTE:[]int = incbin("../res/images/marchant.nespal");
const MARCHANT_BG:[]int = incbin("../res/images/marchant.bg");
const MARCHANT_TILEPAL:[]int = incbin("../res/images/marchant.tilepal");

const ITEM_IDS = [
	ITEM_ID_GAS_MASK, ITEM_ID_COMPASS, ITEM_ID_WATCH,
	ITEM_ID_SECURITY_CARD, ITEM_ID_LAMP, ITEM_ID_OMAMORI,
	ITEM_ID_WING, -1, -1
];

const ITEM_PRICES = [
	4, 3, 6,
	3, 5, 5,
	14, 0, 0
];

const MARCHANT_MEMORY_ID = [50, 51, 52];

//=================================================
// 外部インターフェース
//=================================================

public function event_marchant(kind:uint8):void
{
	event.event_func = run_marchant;
	m.kind = kind;
}

public function is_sold_out(kind:int):bool
{
	var idx_base = kind * 3;
	for (var i = 0; i < 3; i++) {
		var item_id = ITEM_IDS[idx_base + i];
		if (item_id != -1) {
			if (!my.items[item_id]) {
				return false;
			}
		}
	}
	return true;
}

public function get_memory_id(kind:uint8):uint8
{
	return MARCHANT_MEMORY_ID[kind];
}

//=================================================
// メインロジック
//=================================================

function run_marchant():void
{
	ppu.clear_out_sprite();
	ppu.wait_vsync();

	ppu.lock();
	var old_ppu_ctrl1 = ppu.ctrl1_bak;
	var old_cbank0 = mmc3.set_cbank(0, CBANK_MARCHANT + 0);
	var old_cbank1 = mmc3.set_cbank(1, CBANK_MARCHANT + 2);
	var old_cbank2 = ppu.cbank2;
	ppu.cbank2 = CBANK_SYS_SPRITE;
	mmc3.MIRROR = 0; // vertical
	ppu.ctrl1_bak = 0b10100001;

	setup_irqcmd();
	ppu.irq_setup = irqcmd.irq_setup;

	run_marchant_main();

	ppu.irq_setup = ppu.null_func;
	ppu.wait_vsync();
	ppu.lock();
	mmc3.set_cbank(0, old_cbank0);
	mmc3.set_cbank(1, old_cbank1);
	ppu.cbank2 = old_cbank2;
	ppu.ctrl1_bak = old_ppu_ctrl1;
	ppu.put_in_lock(0x3f00, bg.pallet, 16);
	ppu.unlock();
	ppu.wait_vsync();
}

function run_marchant_main():void
{
	ppu.fill_in_lock(0x2400, 0x400, 0);
	ppu.put_palette_in_lock(VRAM_PALETTE, MARCHANT_PALETTE, 16);

	m.idx_base = m.kind * 3;

	m.text = bg.buf;
	draw_message(_I("なにか買ってくかい？\nどれもおかいどくだよ"));

	draw_marchant_in_lock();
	draw_frame_in_lock();

	ppu.unlock();

	draw_all();
	ppu.wait_vsync();

	var idx = 0;
	var old_idx = -1;
	loop {
		pad.update();
		if (pad.pushed & pad.B) {
			break;
		}

		text.talk_process(0);

		var item_id = ITEM_IDS[m.idx_base + idx];
		var price = ITEM_PRICES[m.idx_base + idx];
		if (pad.pushed & pad.A) {
			var wait = 0;
			//ppu.lock();
			if (my.items[item_id] != 0) {
				draw_message(_I("うりきれだよ"));
			} elsif (my.coin_num < price) {
				draw_message(_I("おかねがたりないよ"));
			} else {
				my.items[item_id] = 1;
				my.coin_num -= price;
				draw_item(idx);
				draw_message(_I("ありがとよ"));

				sound.play_se(sound.SE_COIN, 20);
			}
			//ppu.unlock();
			if (wait) {
				for (var i = 0; i < 20; i++) {
					ppu.wait_vsync();
				}
			}
		}

		if (pad.pushed & pad.B) {
			break;
		}

		if (pad.pushed & pad.DOWN) {
			idx = (idx + 1) % 3;
		}
		if (pad.pushed & pad.UP) {
			idx = (idx + 2) % 3;
		}

		if (idx != old_idx) {
			draw_item_desc(item_id);
		}

		ppu.sprite(11 * 8, 19 * 8 + 2 + idx * 16, SPR_ARROW, 0);

		ppu.wait_vsync();
	}
}

//=================================================
// 描画関係
//=================================================

function setup_irqcmd():void
{
	irqcmd.begin();
	irqcmd.add_begin_screen(88, 0, 8, ppu.ctrl1_bak, CBANK_MARCHANT, CBANK_MARCHANT + 2);
	irqcmd.add_screen(96 - 1, 0, 104, 1, ppu.ctrl1_bak, ppu.ctrl2_bak, CBANK_ITEM_TEXT, CBANK_ITEM_TEXT + 2);
	irqcmd.add_cbank_bg(0, CBANK_ITEM_TEXT, CBANK_ITEM_TEXT + 2);
	irqcmd.commit();
}

// 商人のバストアップを描画する
function draw_marchant_in_lock():void
{
	for (var i:uint16 = 0; i < 8; i++) {
		ppu.put_in_lock(ppu.pos(8, 4 + i) + 0x400, &MARCHANT_BG[i * 16], 16);
	}
	for (var i:int16 = 0; i < 2; i++) {
		ppu.put_in_lock(0x27C0 + (1 + i) * 8 + 2, &MARCHANT_TILEPAL[i * 4], 4);
	}
}

// 飾り枠を描画する
function draw_frame_in_lock():void
{
	var buf = ppu.alloc(32);
	mem.set(buf, 254, /*飾り枠*/ 32);
	ppu.put_in_lock(ppu.pos(2, 13) + 0x400, buf, 27);
	ppu.put_in_lock(ppu.pos(2, 19) + 0x400, buf, 27);
	for (var i = 0; i < 5; i++) {
		ppu.put_in_lock(ppu.pos(2, 14 + i) + 0x400, buf, 1);
		ppu.put_in_lock(ppu.pos(28, 14 + i) + 0x400, buf, 1);
	}
}

// 全要素を描画する
function draw_all():void
{
	//draw_message();

	draw_money();

	for (var i = 0; i < 3; i++) {
		draw_item(i);
	}
}

function draw_message(str:*uint8):void
{
	mem.strcpy(m.text, str);
	text.talk_set(0, ppu.pos(4, 14) + 0x400, m.text, 24, 2);
}

function draw_money():void
{
	var line = ppu.alloc(32), line_tail = line;
	line_tail += mem.strcpy(line_tail, _I("しょじきん\n　　"));
	line_tail += text.print_num(line_tail, my.coin_num);
	line_tail += mem.strcpy(line_tail, _I("G"));
	text.screen_print_str(ppu.pos(2, 20) + 0x400, line, 8, 2);
	ppu.wait_vsync_with_flag(2);
}

function draw_item(i:int):void
{
	var item_id = ITEM_IDS[m.idx_base + i];
	var line:*uint8, tail:*uint8;

	line = ppu.alloc(32);
	fs.copy(line, fs.ITEM_DESC_NAME_BASE + item_id);
	text.screen_print_str(ppu.pos(12, 20 + i * 2) + 0x400, line, 12, 1);
	ppu.wait_vsync_with_flag(2);

	if (item_id < 0 || my.items[item_id]) {
		text.screen_print_str(ppu.pos(24, 20 + i * 2) + 0x400, _I("ーうりきれー"), 6, 1);
		ppu.wait_vsync_with_flag(2);
	} else {
		line = tail = ppu.alloc(32);
		tail += text.print_num(tail, ITEM_PRICES[m.idx_base + i]);
		tail += mem.strcpy(tail, _I("G"));
		text.screen_print_str(ppu.pos(24, 20 + i * 2) + 0x400, line, 6, 1);
		ppu.wait_vsync_with_flag(2);
	}
}

function draw_item_desc(item_id:int):void
{
	var line = ppu.alloc(64);
	fs.copy(line, fs.ITEM_DESC_BASE + item_id);
	text.screen_print_str(ppu.pos(2, 26) + 0x400, line, 24, 2);
	ppu.wait_vsync_with_flag(2);
}
