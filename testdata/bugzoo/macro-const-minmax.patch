-					return h.constEval(r.expr)
-				}
-			}
 			call := &cexpr{kind: cOp, op: opCall, args: args, block: c.block, pos: c.pos}
 			if mc := h.methodCall(call); mc != nil {
 				return mc // `x.m(args)` → `T.m(受け取り手, args)` (method.go)
