 }
 
-// isArray は o が配列の値 (読むと番地になる) か。
-func isArray(o ir.Operand) bool {
-	x, ok := o.(*ir.Value)
-	return ok && (x.Kind == ir.KindLocal || x.Kind == ir.KindGlobal) && x.Type.Kind == types.Array
-}
-
