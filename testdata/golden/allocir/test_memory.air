  (var 0 $result local #"u8" lt=result loc=nil)
  (var 1 str local #"*u8" lt=arg loc=nil)
  (var 2 n local #"u8" loc=nil)
  (var 3 $6 local #"*u8" lt=temp loc=nil)
  (var 4 $7 local #"u8" lt=temp loc=nil)
  (var 5 $8 local #"u8" lt=temp loc=nil)
 )
 (ops
  0000 (:load {l2 n} {lit nil 0 #"u8"})
  0001 (:label "@begin_1")
  0002 (:index {l3 $6} {l1 str} {l2 n})
  0003 (:pget {l4 $7} {l3 $6})
  0004 (:if {l4 $7} "@else_4")
  0005 (:label "@then_3")
  0006 (:add {l5 $8} {l2 n} {lit nil 1 #"u8"})
  0007 (:load {l2 n} {l5 $8})
  0008 (:jump "@end_5")
  0009 (:label "@else_4")
  0010 (:jump "@end_2")
  0011 (:label "@end_5")
  0012 (:jump "@begin_1")
  0013 (:label "@end_2")
  0014 (:return {l2 n})
 )
)
(alloc-lambda mem _mem_strcpy _mem_strcpy frame_size=7 abi=static
 (vars
  (var 0 $result local #"u8" lt=result loc=static addr=0)
  (var 1 to local #"*u8" lt=arg loc=static addr=1)
  (var 2 str local #"*u8" lt=arg loc=static addr=3)
  (var 3 i local #"u8" loc=static addr=5)
  (var 4 $14 local #"*u8" lt=temp loc=none unuse)
  (var 5 $15 local #"u8" lt=temp loc=none unuse)
  (var 6 c local #"u8" loc=static addr=6)
  (var 7 $16 local #"*u8" lt=temp loc=none unuse)
  (var 8 $20 local #"u8" lt=temp loc=none unuse)
  (var 9 c@A local #"u8" lt=temp loc=a)
  (var 10 i@Y local #"u8" lt=temp loc=y)
 )
 (ops
  0000 (:load {l3 i} {lit nil 0 #"u8"})
  0001 (:load {l10 i@Y} {l3 i} "y=i@Y")
  0002 (:label "@then_11" "a=c@A" "y=i@Y")
  0003 (:index_pget {l9 c@A} {l2 str} {l10 i@Y} "a=c@A" "y=i@Y")
  0004 (:index_pset {l1 to} {l10 i@Y} {l9 c@A} "a=c@A" "y=i@Y")
  0005 (:if_true {l9 c@A} "@end_19" "a=c@A" "y=i@Y")
  0006 (:load {l3 i} {l10 i@Y} "y=i@Y")
  0007 (:return {l3 i})
  0008 (:label "@end_19" "a=c@A" "y=i@Y")
  0009 (:add {l10 i@Y} {l10 i@Y} {lit nil 1 #"u8"} "a=c@A" "y=i@Y")
  0010 (:jump "@then_11" "a=c@A" "y=i@Y")
 )
)
