 nil
 :test_logical_op
 ()
 :void
 nil
 ((:var ((:T nil 1 nil)) nil)
  (:var ((:F nil 0 nil)) nil)
  (:exp (:call :assert_true ((:land :T :T) "T&&T") nil))
  (:exp (:call :assert_true ((:not (:land :T :F)) "T&&F") nil))
  (:exp (:call :assert_true ((:not (:land :F :T)) "F&&T") nil))
  (:exp (:call :assert_true ((:not (:land :F :F)) "F&&F") nil))
  (:exp (:call :assert_true ((:lor :T :F) "T||F") nil))
  (:exp (:call :assert_true ((:lor :T :F) "T||F") nil))
  (:exp (:call :assert_true ((:lor :F :T) "F||T") nil))
  (:exp (:call :assert_true ((:not (:lor :F :F)) "F||F") nil))))
(:function
 nil
 :test_shift_op
 ()
 :void
 nil
 ((:var ((:i0 nil 0 nil)) nil)
  (:var ((:i1 nil 1 nil)) nil)
  (:var ((:i2 nil 2 nil)) nil)
  (:var ((:i7 nil 7 nil)) nil)
  (:var ((:i20 nil 20 nil)) nil)
  (:exp (:call :assert_equal ((:shift_left 1 2) 4 "<<") nil))
  (:exp (:call :assert_equal ((:shift_left :i1 2) 4 "<<") nil))
  (:exp (:call :assert_equal ((:shift_left :i1 :i0) 1 "<<") nil))
  (:exp (:call :assert_equal ((:shift_left :i1 :i2) 4 "<<") nil))
  (:exp (:call :assert_equal ((:shift_left :i1 :i7) 128 "<<") nil))
  (:exp (:call :assert_equal ((:shift_right 20 2) 5 ">>") nil))
  (:exp (:call :assert_equal ((:shift_right :i20 2) 5 ">>") nil))
  (:exp (:call :assert_equal ((:shift_right :i20 :i0) 20 "<<") nil))
  (:exp (:call :assert_equal ((:shift_right :i20 :i2) 5 ">>") nil))
  (:exp (:call :assert_equal ((:shift_right 255 :i7) 1 ">>") nil))))
