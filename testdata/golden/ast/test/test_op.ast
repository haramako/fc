  (:exp
   (:call
    :assert_equal
    ((:mod 18 (:div (:mul 2 (:sub (:add 10 10) 5)) 3)) 8 "+,-,*,/,%")
    nil))
  (:exp (:call :assert_true ((:lt :w1 :i2) "<") nil))
  (:exp (:call :assert_true ((:not (:lt :w2 :i2)) "!,<") nil))
  (:exp (:call :assert_true ((:gt :w2 :i1) ">") nil))
  (:exp (:call :assert_true ((:not (:gt :w2 :i2)) "!,>") nil))
  (:exp (:call :assert_true ((:le :w2 :i2) "<=") nil))
  (:exp (:call :assert_true ((:not (:le :w3 :i2)) "!,<=") nil))
  (:exp (:call :assert_true ((:ge :w3 :i2) ">=") nil))
  (:exp (:call :assert_true ((:not (:ge :w2 :i3)) "!,>=") nil))
  (:exp (:call :assert_true ((:eq :w2 :i2) "==") nil))
  (:exp (:call :assert_true ((:ne :w2 :i3) "!=") nil))))
