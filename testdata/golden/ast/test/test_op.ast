  (:exp (:call :assert_equal ((:mul :i1 0) 0 "*0") nil))
  (:exp (:call :assert_equal (:i1 :i1 "num") nil))
  (:exp (:call :assert_equal ((:mul :i2 :i3) 6 "2*3") nil))
  (:exp (:call :assert_equal ((:mul :i5 :i5) 25 "+,-,*,/,%") nil))
  (:exp (:call :assert_equal ((:mul :i5 60) 44 "+,-,*,/,%") nil))
  (:exp (:call :assert_equal ((:div :i10 :i3) 3 "/") nil))
  (:exp (:call :assert_equal ((:div 255 :i10) 25 "/") nil))
  (:exp (:call :assert_equal ((:mod 255 :i10) 5 "%") nil))
  (:exp
   (:call
    :assert_equal
    ((:mod 18 (:div (:mul :i2 (:sub (:add :i10 :i10) :i5)) :i3)) 8 "+,-,*,/,%")
    nil))
  (:exp (:call :assert_equal ((:and :i3 :i2) 2 "&") nil))
  (:exp (:call :assert_equal ((:or :i1 :i2) 3 "|") nil))
  (:exp (:call :assert_equal ((:xor :i3 :i2) 1 "^") nil))
  (:exp (:call :assert_true ((:lt :i1 :i2) "<") nil))
  (:exp (:call :assert_true ((:not (:lt :i2 :i2)) "!,<") nil))
  (:exp (:call :assert_true ((:gt :i2 :i1) ">") nil))
  (:exp (:call :assert_true ((:not (:gt :i2 :i2)) "!,>") nil))
  (:exp (:call :assert_true ((:le :i2 :i2) "<=") nil))
  (:exp (:call :assert_true ((:not (:le :i3 :i2)) "!,<=") nil))
  (:exp (:call :assert_true ((:ge :i3 :i2) ">=") nil))
  (:exp (:call :assert_true ((:not (:ge :i2 :i3)) "!,>=") nil))
  (:exp (:call :assert_true ((:eq :i2 :i2) "==") nil))
  (:exp (:call :assert_true ((:ne :i2 :i3) "!=") nil))
  (:exp (:call :assert_equal ((:mul :i10 16) 160 "*const") nil))
  (:exp (:call :assert_equal ((:div :i10 4) 2 "/const") nil))
  (:exp (:call :assert_equal ((:mod :i10 8) 2 "%const") nil))
  (:exp (:call :assert_equal (1 1 "+1") nil))
  (:exp (:call :assert_equal (:i1 1 "+i1") nil))
  (:exp (:call :assert_equal ((:uminus :i1) 255 "-i1") nil))))
(:function
 nil
 :test_int8_op
 ()
 :void
 nil
 ((:var ((:i1 :sint8 (:uminus 1) nil)) nil)
  (:var ((:i2 :sint8 (:uminus 2) nil)) nil)
  (:var ((:i3 :sint8 3 nil)) nil)
  (:var ((:m3 :sint8 (:uminus 3) nil)) nil)
  (:var ((:i5 :sint8 (:uminus 5) nil)) nil)
  (:var ((:i10 :sint8 10 nil)) nil)
  (:var ((:m10 :sint8 (:uminus 10) nil)) nil)
  (:var ((:m127 :sint8 (:uminus 127) nil)) nil)
  (:exp (:call :assert_equal ((:div :m10 4) (:uminus 3) "-10/4") nil))
  (:exp (:call :assert_equal ((:mul :m10 2) (:uminus 20) "-10*2") nil))
  (:exp (:call :assert_equal (:i1 :i1 "num") nil))
  (:exp (:call :assert_equal ((:div :i10 :i3) 3 "10/3") nil))
  (:exp (:call :assert_equal ((:div :m10 :i3) (:uminus 4) "10/-3") nil))
  (:exp (:call :assert_equal ((:div :i10 :m3) (:uminus 4) "-10/-3") nil))
  (:exp (:call :assert_equal ((:div :m10 :m3) 3 "-10/-3") nil))
  (:exp (:call :assert_equal ((:div :i10 :i2) (:uminus 5) "+,-,*,/,%") nil))
  (:exp (:call :assert_equal ((:mul :i5 :i5) 25 "+,-,*,/,%") nil))
  (:exp (:call :assert_equal ((:mul :i5 60) (:uminus 44) "+,-,*,/,%") nil))
  (:exp (:call :assert_equal ((:div :i10 :i3) 3 "/") nil))
  (:exp (:call :assert_equal ((:div 255 :i10) (:uminus 1) "/") nil))
  (:exp (:call :assert_equal ((:and :i3 :i2) 2 "&") nil))
  (:exp (:call :assert_equal ((:or :i1 :i2) (:uminus 1) "|") nil))
  (:exp (:call :assert_equal ((:xor :i3 :i2) (:uminus 3) "^") nil))
  (:exp (:call :assert_true ((:lt :i2 :i1) "<") nil))
  (:exp (:call :assert_true ((:lt :i2 (:uminus 1)) "<") nil))
  (:exp (:call :assert_true ((:gt :i2 (:uminus 16)) "<") nil))
  (:exp (:call :assert_true ((:lt :i2 1) "<") nil))
  (:exp (:call :assert_true ((:not (:gt :i2 1)) ">") nil))
  (:exp (:call :assert_true ((:gt :i3 1) "<") nil))
  (:exp (:call :assert_true ((:not (:lt :i2 :i2)) "!,<") nil))
  (:exp (:call :assert_true ((:gt :i1 :i2) ">") nil))
  (:exp (:call :assert_true ((:not (:gt :i2 :i2)) "!,>") nil))
  (:exp (:call :assert_true ((:le :i2 :i2) "<=") nil))
  (:exp (:call :assert_true ((:not (:le :i3 :i2)) "!,<=") nil))
  (:exp (:call :assert_true ((:ge :i3 :i2) ">=") nil))
  (:exp (:call :assert_true ((:not (:ge :i2 :i3)) "!,>=") nil))
  (:exp (:call :assert_true ((:eq :i2 :i2) "==") nil))
  (:exp (:call :assert_true ((:ne :i2 :i3) "!=") nil))
  (:exp (:call :assert_equal ((:mul :m10 16) 96 "*const") nil))
  (:exp (:call :assert_equal ((:div :m10 4) (:uminus 3) "/const") nil))
  (:exp (:call :assert_equal ((:mod :m10 8) 6 "%const") nil))))
