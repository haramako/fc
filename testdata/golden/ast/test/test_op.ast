(:function
 nil
 :test_pointer_op
 ()
 :void
 nil
 ((:var ((:pgi nil (:ref :gi) nil)) nil)
  (:exp (:load :gi 99))
  (:exp (:call :assert_equal ((:deref :pgi) 99 "&x") nil))
  (:exp (:load (:deref :pgi) 98))
  (:exp (:call :assert_equal (:gi 98 "*px") nil))
  (:var ((:pgw nil (:ref :gw) nil)) nil)
  (:exp (:load :gw 9999))
  (:exp (:call :assert_equal ((:deref :pgw) 9999 "&w") nil))
  (:exp (:load (:deref :pgw) 9998))
  (:exp (:call :assert_equal (:gw 9998 "*pw") nil))
  (:var ((:i nil 99 nil)) nil)
  (:var ((:pi (:pointer :int) (:ref :i) nil)) nil)
  (:exp (:call :assert_equal ((:deref :pi) 99 "&pi") nil))
  (:exp (:load :i 98))
  (:exp (:call :assert_equal ((:deref :pi) 98 "*pi") nil))
  (:var ((:w :int16 9999 nil)) nil)
  (:var ((:pw (:pointer :int16) (:ref :w) nil)) nil)
  (:exp (:call :assert_equal ((:deref :pw) 9999 "&pi") nil))
  (:exp (:load :w 9998))
  (:exp (:call :assert_equal ((:deref :pw) 9998 "*pi") nil))))
