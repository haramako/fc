(:use :lzw nil nil)
(:use :mem nil nil)
(:use :unittest nil "*")
(:use :stdio nil "*")
(:function
 nil
 :test_read_bit
 ()
 :void
 nil
 ((:exp (:load (:dot :lzw :addr) (:array (5 57 119))))
  (:exp (:load (:dot :lzw :bpos) 0))
  (:var ((:x :int nil nil)) nil)
  (:for
   :x
   0
   8
   (
    (:exp
     (:call :assert_equal ((:call (:dot :lzw :read_bit) (3) nil) :x "read_bit") nil))))))
(:function
 nil
 :test_read_bit2
 ()
 :void
 nil
 ((:exp (:load (:dot :lzw :addr) (:array (15 255 240))))
  (:exp (:load (:dot :lzw :bpos) 0))
  (:exp
   (:call
    :assert_equal
    ((:call (:dot :lzw :read_bit) (4) nil) 0 "read_bit2(0)")
    nil))
  (:exp
   (:call
    :assert_equal
    ((:call (:dot :lzw :read_bit) (16) nil) (:uminus 1) "read_bit2(1)")
    nil))
  (:exp
   (:call
    :assert_equal
    ((:call (:dot :lzw :read_bit) (4) nil) 0 "read_bit2(2)")
    nil))))
(:function
 nil
 :test_read_vln
 ()
 :void
 nil
 ((:exp (:load (:dot :lzw :addr) (:array (78 4))))
  (:exp (:load (:dot :lzw :bpos) 0))
  (:exp
   (:call :assert_equal ((:call (:dot :lzw :read_vln) () nil) 9 "read_vln(0)") nil))
  (:exp
   (:call
    :assert_equal
    ((:call (:dot :lzw :read_vln) () nil) 129 "read_vln(1)")
    nil))))
(:function
 nil
 :test_read_vln16
 ()
 :void
 nil
 ((:exp (:load (:dot :lzw :addr) (:array (64 224 0 64))))
  (:exp (:load (:dot :lzw :bpos) 0))
  (:exp
   (:call
    :assert_equal
    ((:call (:dot :lzw :read_vln16) () nil) 129 "read_vln16(0)")
    nil))
  (:exp
   (:call
    :assert_equal
    ((:call (:dot :lzw :read_vln16) () nil) 32769 "read_vln16(1)")
    nil))))
(:var ((:buf (:array 256 :int) nil nil)) nil)
(:function
 nil
 :test_unpack
 ()
 :void
 nil
 (
  (:const
   ((:PACKED nil (:array (12 82 44 182 203 101 190 64 51 40 200 145 37 192)) nil))
   nil)
  (:const ((:UNPACKED nil "Hello Hello Hello Fello." nil)) nil)
  (:var ((:len nil (:call (:dot :lzw :unpack) (:buf :PACKED) nil) nil)) nil)
  (:exp
   (:call
    :assert_equal
    (:len (:call (:dot :mem :strlen) (:UNPACKED) nil) "len")
    nil))
  (:exp
   (:call
    :assert_equal
    ((:call (:dot :mem :compare) (:buf :UNPACKED :len) nil) 0 "compare")
    nil))))
(:function nil :main () :void nil ((:exp (:call :unittest_run_tests () nil))))
