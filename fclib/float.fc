#fc 4
// 浮動小数 (f32 = IEEE 754 binary32、f16 = binary16) の演算。sema が f32 / f16 の演算・比較・変換・数学の関数から呼ぶ (直接呼ばなくて
// よい)。値はビットの並び (u32 / u16) で受け渡す。最近接偶数丸め・非正規化数・±0・±無限大・NaN に従い、NaN を作る演算の結果は
// 0x7fc00000 (f16 は 0x7e00。sema の定数の畳み込みと同じ)。f16 の演算は f32 に広げて計算して丸め直す。
//
// 本体は float.asm (仮数は 27 ビット: 上から 24 ビットが仮数、下の 3 ビットが丸めの印。作業域は reg)。
@(bank: -1);

// a + b
public function add32(a:u32, b:u32):u32 @(abi: "frame");
// a - b
public function sub32(a:u32, b:u32):u32 @(abi: "frame");
// a × b
public function mul32(a:u32, b:u32):u32 @(abi: "frame", scratch: 8);
// a ÷ b
public function div32(a:u32, b:u32):u32 @(abi: "frame", scratch: 5);
// √a (正しく丸める)
public function sqrt32(a:u32):u32 @(abi: "frame", scratch: 17);
// a == b (NaN はどれとも等しくない、+0 と -0 は等しい)
public function eq32(a:u32, b:u32):bool @(abi: "frame");
// a < b (NaN との比較は偽)
public function lt32(a:u32, b:u32):bool @(abi: "frame");
// a <= b (NaN との比較は偽)
public function le32(a:u32, b:u32):bool @(abi: "frame");
// 符号付きの整数 → f32
public function from_i32(n:i32):u32 @(abi: "frame");
// 符号なしの整数 → f32
public function from_u32(n:u32):u32 @(abi: "frame");
// f32 → 符号付きの整数 (0 へ切り捨て、範囲の外は端に飽和、NaN は 0)
public function to_i32(x:u32):i32 @(abi: "frame");
// f32 → 符号なしの整数 (0 へ切り捨て、範囲の外は端に飽和、NaN は 0)
public function to_u32(x:u32):u32 @(abi: "frame");
// 最も近い整数 (ちょうど中間なら偶数)
public function rint32(x:u32):u32 @(abi: "frame");
// 負の無限大の向きの整数 (floor)
public function floor32(x:u32):u32 @(abi: "frame");
// 正の無限大の向きの整数 (ceil)
public function ceil32(x:u32):u32 @(abi: "frame");
// 0 の向きの整数 (trunc)
public function trunc32(x:u32):u32 @(abi: "frame");
// 四捨五入 (ちょうど中間なら 0 から遠い向き)
public function round32(x:u32):u32 @(abi: "frame");
// x × 2^n (固定小数との変換。最近接偶数に丸める)
public function ldexp32(x:u32, n:i16):u32 @(abi: "frame");
// x × 2^n を整数にして (rnd なら最近接偶数、でなければ 0 へ切り捨て)、符号付きの bits ビットの範囲に飽和させる (NaN は 0)。
// f32 → 整数 (n = 0) ・固定小数 (n は小数のビット数) の `as` (sema が呼ぶ所に 1 つの呼び出しで済むように)
public function to_sat_i(x:u32, n:i16, rnd:bool, bits:u8):i32 @(abi: "frame");
// to_sat_i の符号なし (0〜2^bits - 1 に飽和)
public function to_sat_u(x:u32, n:i16, rnd:bool, bits:u8):u32 @(abi: "frame");
// f16 → f32 (正確)
public function from16(h:u16):u32 @(abi: "frame");
// f32 → f16 (最近接偶数に丸める。NaN は 0x7e00)
public function to16(x:u32):u16 @(abi: "frame");
@include("float.asm");
