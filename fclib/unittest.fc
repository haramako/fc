#fc 3
public use stdio;

public function assert_true(a:u8, message:*const u8):void
{
	if (!a) {
		stdio.printf("\nERROR: ", message, "  expects true but false\n");
		stdio.exit(1);
	} else {
		stdio.print('.');
	}
}

public function assert_equal(a:u16, b:u16, message:*const u8):void
{
	if (a != b) {
		stdio.printf("\nERROR: ", message, "  expects ", b, "  but ", a, "\n");
		stdio.exit(1);
	} else {
		stdio.print('.');
	}
}
