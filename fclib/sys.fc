#fc 4
// プログラムを止める (panic / assert)。console に出して終了コード 1 で終える (NES は画面を出して止まる。console.init の後で
// 使う: 描画中の画面に直に書くので)。
@(bank: -1);
use console;

// "panic: " と msg を console に出して止まる (emu は終了コード 1 で終わる)
public function panic(msg:[:u16]const u8):void
{
	console.write("panic: ");
	console.write(msg);
	console.newline();
	console.exit(1);
}

// cond が偽なら panic
public function assert(cond:bool, msg:[:u16]const u8):void
{
	if (!cond) {
		panic(msg);
	}
}
