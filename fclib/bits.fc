#fc 4
// ビット集合と 2 ビットの欄 (doc/v4_stdlib.md §3.1)。i 番目のビットは s[i / 8] の 1 << (i % 8) (下位から)。添字は u8 (256 個まで)。
@(bank: -1);

public const MASK = [1, 2, 4, 8, 16, 32, 64, 128];

public function get(s:[]const u8, i:u8):bool
{
	return (s[i >> 3] & MASK[i & 7]) != 0;
}

public function set(s:[]u8, i:u8):void
{
	s[i >> 3] |= MASK[i & 7];
}

public function clear(s:[]u8, i:u8):void
{
	s[i >> 3] &= ~MASK[i & 7];
}

public function flip(s:[]u8, i:u8):void
{
	s[i >> 3] ^= MASK[i & 7];
}

// 立っているビットの数
public function count(s:[]const u8):u16
{
	var n:u16 = 0;
	for (var c in s) {
		var b = c;
		while (b != 0) {
			b &= b - 1;   // いちばん下の立っているビットを消す
			n += 1;
		}
	}
	return n;
}

// b の i 番目 (0〜3。下位から) の 2 ビットの欄を v (0〜3) にした値 (属性テーブルの 1 バイトの 4 つの区画など)
public function field2(b:u8, i:u8, v:u8):u8
{
	var shift = (i & 3) << 1;
	return (b & ~(3 << shift)) | ((v & 3) << shift);
}

// b の i 番目の 2 ビットの欄の値
public function get2(b:u8, i:u8):u8
{
	return (b >> ((i & 3) << 1)) & 3;
}

// ---- テスト ----

function test_set():void @(test)
{
	var s:[4]u8;
	set(s, 0);
	set(s, 9);
	set(s, 31);
	@assert(get(s, 0) && get(s, 9) && get(s, 31));
	@assert(!get(s, 1) && !get(s, 8) && !get(s, 30));
	@assert_eq(s[1], 2);
	@assert_eq(count(s), 3);
	clear(s, 9);
	flip(s, 0);
	flip(s, 1);
	@assert(!get(s, 9) && !get(s, 0) && get(s, 1));
	@assert_eq(count(s), 2);
}

function test_field2():void @(test)
{
	@assert_eq(field2(0, 0, 3), 3);
	@assert_eq(field2(0, 3, 2), 0x80);
	@assert_eq(field2(0xff, 1, 0), 0xf3);
	@assert_eq(get2(0x80, 3), 2);
	@assert_eq(get2(0xf3, 1), 0);
}
