#fc 4
// ビット集合と 2 ビットの欄。i 番目のビットは s[i / 8] の 1 << (i % 8) (下位から)。get などの添字は u8 (256 個まで)。
// それより大きい集合は get_w など (添字が u16、集合は [:u16] の slice。少し遅い)。
@(bank: -1);

public const MASK = [1, 2, 4, 8, 16, 32, 64, 128];

// i 番目のビットが立っているか
public function get(s:[]const u8, i:u8):bool
{
	return (s[i >> 3] & MASK[i & 7]) != 0;
}

// i 番目のビットを立てる
public function set(s:[]u8, i:u8):void
{
	s[i >> 3] |= MASK[i & 7];
}

// i 番目のビットを下ろす
public function clear(s:[]u8, i:u8):void
{
	s[i >> 3] &= ~MASK[i & 7];
}

// i 番目のビットを反転する
public function flip(s:[]u8, i:u8):void
{
	s[i >> 3] ^= MASK[i & 7];
}

// get の添字が u16 の版 (256 個より大きい集合)
public function get_w(s:[:u16]const u8, i:u16):bool
{
	return (s[i >> 3] & MASK[(i as u8) & 7]) != 0;
}

// set の添字が u16 の版
public function set_w(s:[:u16]u8, i:u16):void
{
	s[i >> 3] |= MASK[(i as u8) & 7];
}

// clear の添字が u16 の版
public function clear_w(s:[:u16]u8, i:u16):void
{
	s[i >> 3] &= ~MASK[(i as u8) & 7];
}

// flip の添字が u16 の版
public function flip_w(s:[:u16]u8, i:u16):void
{
	s[i >> 3] ^= MASK[(i as u8) & 7];
}

// 立っているビットの数
public function count(s:[:u16]const u8):u16
{
	var n:u16 = 0;
	for (var c in s) {
		var b = c;
		while (b != 0) {
			b &= b - 1;   // いちばん下の立っているビットを消す
			n += 1;
		}
	}
	return n;
}

// b の i 番目 (0〜3。下位から) の 2 ビットの欄を v (0〜3) にした値 (属性テーブルの 1 バイトの 4 つの区画など)
public function field2(b:u8, i:u8, v:u8):u8
{
	var shift = (i & 3) << 1;
	return (b & ~(3 << shift)) | ((v & 3) << shift);
}

// b の i 番目の 2 ビットの欄の値
public function get2(b:u8, i:u8):u8
{
	return (b >> ((i & 3) << 1)) & 3;
}

// ---- テスト ----

function test_set():void @(test)
{
	var s:[4]u8;
	set(s, 0);
	set(s, 9);
	set(s, 31);
	@assert(get(s, 0) && get(s, 9) && get(s, 31));
	@assert(!get(s, 1) && !get(s, 8) && !get(s, 30));
	@assert_eq(s[1], 2);
	@assert_eq(count(s), 3);
	clear(s, 9);
	flip(s, 0);
	flip(s, 1);
	@assert(!get(s, 9) && !get(s, 0) && get(s, 1));
	@assert_eq(count(s), 2);
}

function test_wide():void @(test)
{
	var s:[100]u8;
	set_w(s, 0);
	set_w(s, 300);
	set_w(s, 799);
	@assert(get_w(s, 0) && get_w(s, 300) && get_w(s, 799));
	@assert(!get_w(s, 299) && !get_w(s, 301) && !get_w(s, 44));
	@assert_eq(s[37], 0x10);
	@assert_eq(count(s), 3);
	clear_w(s, 300);
	flip_w(s, 799);
	flip_w(s, 512);
	@assert(!get_w(s, 300) && !get_w(s, 799) && get_w(s, 512));
	@assert_eq(count(s), 2);
}

function test_field2():void @(test)
{
	@assert_eq(field2(0, 0, 3), 3);
	@assert_eq(field2(0, 3, 2), 0x80);
	@assert_eq(field2(0xff, 1, 0), 0xf3);
	@assert_eq(get2(0x80, 3), 2);
	@assert_eq(get2(0xf3, 1), 0);
}
