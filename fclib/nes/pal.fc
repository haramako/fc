#fc 4
// パレット。32 色 (背景 16 + スプライト 16) の元の色と明るさを持ち、変えたら明るさを掛けた色を vram の
// キューに積む (次の frame.wait の NMI で送る。NMI は写すだけで、明るさの計算は主の側)。
//
//   pal.set_all(PALETTE);
//   pal.bright(0); frame.render_on(); pal.fade(4, 4);   // 黒から 4 フレームごとに明るく
@(bank: -1);
use vram;
use frame;

public const BLACK = 0x0f;
public const WHITE = 0x30;

var colors:[32]u8;     // 明るさ 4 の色
var level:u8;          // 明るさ - 4 (0 が元の色。RAM の初期値の 0 で元の色になるように)

// p を先頭から並べる (32 色まで。短ければ残りはそのまま)
public function set_all(p:[]const u8):void
{
	var n = @len(p);
	if (n > 32) {
		n = 32;
	}
	for (var i:u8 = 0; i < n; i += 1) {
		colors[i] = p[i];
	}
	upload();
}

// i 番の色 (0〜31。16〜31 はスプライト。16 / 20 / 24 / 28 は PPU で 0 / 4 / 8 / 12 と同じ所なので、そちらの色が出る)。
// その 1 色だけを積む (vram のキューの 4 バイト)
public function set(i:u8, c:u8):void
{
	i &= 31;
	colors[i] = c;
	upload_range(i, 1);
}

// i 番から続く色を p にする (32 番を超える分は捨てる)。まとめて 1 つの項目で積む (色回しで何色も変えるときに。set を色の数だけ
// 呼ぶより軽い)
public function set_range(i:u8, p:[]const u8):void
{
	i &= 31;
	var n = @len(p);
	if (n > 32 - i) {
		n = 32 - i;
	}
	for (var k:u8 = 0; k < n; k += 1) {
		colors[i + k] = p[k];
	}
	upload_range(i, n);
}

// i 番の元の色 (明るさを掛ける前)
public function get(i:u8):u8
{
	return colors[i & 31];
}

// 明るさ: 0 (真っ黒) 〜 4 (元の色) 〜 8 (真っ白)
public function bright(l:u8):void
{
	if (l > 8) {
		l = 8;
	}
	level = l - 4;
	upload();
}

// 今の明るさ (0〜8)
public function brightness():u8
{
	return level + 4;
}

// 今の明るさから to まで 1 段ずつ変える (1 段ごとに frames フレーム待つ。描画を出していること)
public function fade(to:u8, frames:u8):void
{
	var l = brightness();
	while (l != to) {
		if (l < to) {
			l += 1;
		} else {
			l -= 1;
		}
		bright(l);
		frame.wait_n(frames);
	}
}

// 明るさ 4 + d の色 (d は -4〜4)。暗くするときは 1 段ごとに $10 を引き、無くなれば黒。明るくするときは $10 を足し、$3x を超えれば白。
// 黒 ($xE / $xF) は明るくすると $00 → $10 → $20 → $30 の灰色に
public function shade(c:u8, d:i8):u8 @(abi: "frame");
@include("pal.asm");

function upload():void
{
	upload_range(0, 32);
}

// at 番から n 色を、明るさを掛けて 1 つの項目で積む
function upload_range(at:u8, n:u8):void
{
	var dst = vram.reserve(0x3f00 + at, n);
	var d = @bitcast(i8, level);
	for (var k:u8 = 0; k < n; k += 1) {
		// $3F10 / $3F14 / $3F18 / $3F1C は $3F00 / $3F04 / $3F08 / $3F0C と同じ所 (PPU の写し): 背景の色を書く (スプライトの色 0 は
		// 透明なので使われない。colors[16] などに 0 が入っていても背景色を消さないように)
		var j = at + k;
		if ((j & 0x13) == 0x10) {
			j &= 0x0f;
		}
		dst[k] = shade(colors[j], d);
	}
}

// ---- テスト ----

// shade の fc の版 (pal.asm と全部の入力で比べる)
function shade_ref(c:u8, d:i8):u8
{
	if (d == 0) {
		return c;
	}
	var lo = c & 0x0f;
	var hi = c >> 4;
	if (d < 0) {
		var k = @bitcast(u8, -d);
		if (lo >= 0x0e || hi < k) {
			return BLACK;
		}
		c -= k << 4;
		if (c == 0x0d) {
			return BLACK;
		}
		return c;
	}
	var k = @bitcast(u8, d);
	if (lo >= 0x0e) {
		return (k - 1) << 4;
	}
	if (hi + k > 3) {
		return WHITE;
	}
	return c + (k << 4);
}

function test_shade_all():void @(test)
{
	for (var d:i8 = -8; d <= 8; d += 1) {
		for (var c in 0..64) {
			@assert_eq(shade(c, d), shade_ref(c, d));
		}
	}
}

function test_shade():void @(test)
{
	@assert_eq(shade(0x21, 0), 0x21);
	@assert_eq(shade(0x21, -1), 0x11);
	@assert_eq(shade(0x21, -2), 0x01);
	@assert_eq(shade(0x21, -3), BLACK);
	@assert_eq(shade(0x1d, -1), BLACK);
	@assert_eq(shade(0x0f, -1), BLACK);
	@assert_eq(shade(0x21, 1), 0x31);
	@assert_eq(shade(0x21, 2), WHITE);
	@assert_eq(shade(0x0f, 1), 0x00);
	@assert_eq(shade(0x0f, 4), 0x30);
	@assert_eq(shade(0x16, 4), WHITE);
}
