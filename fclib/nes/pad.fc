#fc 3
@(bank: -1);

use nes;

public var a:u8;
public var b:u8;
public var select:u8;
public var start:u8;
public var up:u8;
public var down:u8;
public var left:u8;
public var right:u8;
public var cur:u8;
public var prev:u8;
public var pushed:u8;

public const A = 1 << 7;
public const B = 1 << 6;
public const SELECT = 1 << 5;
public const START = 1 << 4;
public const UP = 1 << 3;
public const DOWN = 1 << 2;
public const LEFT = 1 << 1;
public const RIGHT = 1 << 0;

public function update():void
{
	nes.PAD_CTRL = 1;
	nes.PAD_CTRL = 0;
	a = nes.PAD_CTRL % 2;
	b = nes.PAD_CTRL % 2;
	select = nes.PAD_CTRL % 2;
	start = nes.PAD_CTRL % 2;
	up = nes.PAD_CTRL % 2;
	down = nes.PAD_CTRL % 2;
	left = nes.PAD_CTRL % 2;
	right = nes.PAD_CTRL % 2;

	prev = cur;
	cur = (cur << 1) | a;
	cur = (cur << 1) | b;
	cur = (cur << 1) | select;
	cur = (cur << 1) | start;
	cur = (cur << 1) | up;
	cur = (cur << 1) | down;
	cur = (cur << 1) | left;
	cur = (cur << 1) | right;
	pushed = (prev ^ 255) & cur;
}
