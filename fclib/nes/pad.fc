#fc 4
// パッド (Agent/wiki/plans/v4-stdlib.md §3.2)。poll をフレームに 1 回呼ぶと、p1 / p2 に押している (held)・今押した (pressed)・今離した
// (released) ボタンと、キーリピート (repeat: 押した瞬間と、押し続けて REPEAT_DELAY フレーム後から REPEAT_RATE フレームごと。
// メニューのカーソルの移動に) が入る。DMC (音の再生) が読み取りに割り込んでビットがずれることがあるので、2 回続けて同じ値になるまで読み直す。
// 旧版 (pad.cur / pad.pushed) は examples/castle/src/pad.fc・examples/miku/pad.fc にコピーがある。
//
//   pad.poll();
//   if ((pad.p1.pressed & pad.A) != 0) { jump(); }
@(bank: -1);
use nes;

public const A = 0x80;
public const B = 0x40;
public const SELECT = 0x20;
public const START = 0x10;
public const UP = 0x08;
public const DOWN = 0x04;
public const LEFT = 0x02;
public const RIGHT = 0x01;

// キーリピートの間隔 (フレーム)。fc.toml の [define.pad] か -D pad.REPEAT_DELAY=20 で変えられる
public const REPEAT_DELAY = 16 @(build);
public const REPEAT_RATE = 4 @(build);

public struct Pad {
	held:u8;
	pressed:u8;
	released:u8;
	repeat:u8;   // 押した瞬間と、押し続けている間の一定の間隔 (押しているボタン全部)
	timer:u8;    // 次のリピートまでのフレーム
}

public var p1:Pad;
public var p2:Pad;

var r1:u8;
var r2:u8;

// 両方のパッドを 1 回読む (bit 1 はファミコンの拡張端子のパッド)
function read():void
{
	nes.JOY1 = 1;
	nes.JOY1 = 0;
	var a:u8 = 0;
	var b:u8 = 0;
	for (var i:u8 = 0; i < 8; i += 1) {
		a <<= 1;
		if ((nes.JOY1 & 3) != 0) {
			a |= 1;
		}
		b <<= 1;
		if ((nes.JOY2 & 3) != 0) {
			b |= 1;
		}
	}
	r1 = a;
	r2 = b;
}

function update(p:*Pad, now:u8):void
{
	var pressed = now & ~p.held;
	p.pressed = pressed;
	p.released = p.held & ~now;
	p.held = now;
	if (pressed != 0) {
		// 新しく押したボタンだけを立てて、待ちを始めからにする
		p.repeat = pressed;
		p.timer = REPEAT_DELAY;
		return;
	}
	p.repeat = 0;
	if (now == 0) {
		return;
	}
	p.timer -= 1;
	if (p.timer == 0) {
		p.repeat = now;
		p.timer = REPEAT_RATE;
	}
}

public function poll():void
{
	read();
	var a = r1;
	var b = r2;
	while (true) {
		read();
		if (r1 == a && r2 == b) {
			break;
		}
		a = r1;
		b = r2;
	}
	update(&p1, a);
	update(&p2, b);
}
