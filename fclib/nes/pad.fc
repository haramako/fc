#fc 4
// パッド (doc/v4_stdlib.md §3.2)。poll をフレームに 1 回呼ぶと、p1 / p2 に押している (held)・今押した (pressed)・今離した
// (released) ボタンが入る。DMC (音の再生) が読み取りに割り込んでビットがずれることがあるので、2 回続けて同じ値になるまで読み直す。
// 旧版 (pad.cur / pad.pushed) は examples/castle/src/pad.fc・examples/miku/pad.fc にコピーがある。
//
//   pad.poll();
//   if ((pad.p1.pressed & pad.A) != 0) { jump(); }
@(bank: -1);
use nes;

public const A = 0x80;
public const B = 0x40;
public const SELECT = 0x20;
public const START = 0x10;
public const UP = 0x08;
public const DOWN = 0x04;
public const LEFT = 0x02;
public const RIGHT = 0x01;

public struct Pad {
	held:u8;
	pressed:u8;
	released:u8;
}

public var p1:Pad;
public var p2:Pad;

var r1:u8;
var r2:u8;

// 両方のパッドを 1 回読む (bit 1 はファミコンの拡張端子のパッド)
function read():void
{
	nes.JOY1 = 1;
	nes.JOY1 = 0;
	var a:u8 = 0;
	var b:u8 = 0;
	for (var i:u8 = 0; i < 8; i += 1) {
		a <<= 1;
		if ((nes.JOY1 & 3) != 0) {
			a |= 1;
		}
		b <<= 1;
		if ((nes.JOY2 & 3) != 0) {
			b |= 1;
		}
	}
	r1 = a;
	r2 = b;
}

function update(p:*Pad, now:u8):void
{
	p.pressed = now & ~p.held;
	p.released = p.held & ~now;
	p.held = now;
}

public function poll():void
{
	read();
	var a = r1;
	var b = r2;
	while (true) {
		read();
		if (r1 == a && r2 == b) {
			break;
		}
		a = r1;
		b = r2;
	}
	update(&p1, a);
	update(&p2, b);
}
