#fc 4
// デバッグ出力 (NES: 描画を止めている間に、PPU のネームテーブル 0 へ直に書く。文字のコードをそのままタイルの番号にするので、
// ASCII の並びのフォントの CHR が要る)。printf / @assert / sys.panic の出力先。ゲームの画面は vram (NMI で送るキュー) を使う。
@(bank: -1);
use nes;

public var addr:u16;       // 次に書く VRAM の番地
// fc の NES のランナー (internal/nes) への出力: 書いた文字をそのまま出す / 終了コード。$4018〜$401F は CPU の試験用の番地で、
// 製品の NES では何も起きない (マッパーも $4020 から)。画面は 30 行で上に戻るが、fcc test -t nes はこちらで全部を受け取る
var DEBUG_OUT:u8 @(address: 0x4018);
var DEBUG_EXIT:u8 @(address: 0x4019);
// exit の終了コードと印 (テストのランナーが外から読むので volatile: 戻らない exit の中でレジスタに置いたままにならないように)
public var exit_code:u8 @(volatile);
public var exited:u8 @(volatile);
var ready:bool;            // init の後

// 描画と NMI を止め、パレットを置いて左上から書けるようにする
public function init():void
{
	nes.PPUCTRL = 0;
	nes.PPUMASK = 0;
	const PALETTE = [15, 48, 48, 48, 15, 48, 48, 48, 15, 48, 48, 48, 15, 48, 48, 48];
	nes.PPUADDR = 0x3f;
	nes.PPUADDR = 0x00;
	for (var c in PALETTE) {
		nes.PPUDATA = c;
	}
	addr = 0x2000;
	ready = true;
}

// panic の前に: init をまだ呼んでいなければ (描画中のゲーム)、描画と NMI を止めて init し、ネームテーブル 0 を空白にする
// (描画中の PPU に書いても画面に出ない。ゲームの画面の上に重ねると読めない)
public function claim():void
{
	if (ready) {
		return;
	}
	init();
	nes.PPUADDR = 0x20;
	nes.PPUADDR = 0x00;
	for (var i:u16 = 0; i < 960; i += 1) {
		nes.PPUDATA = ' ';
	}
	for (var i:u8 = 0; i < 64; i += 1) {
		nes.PPUDATA = 0;   // 属性
	}
}

// s をそのまま書く ('\n' は次の行の頭へ)
public function write(s:[:u16]const u8):void
{
	nes.PPUADDR = (addr >> 8) as u8;
	nes.PPUADDR = addr as u8;
	for (var c in s) {
		DEBUG_OUT = c;
		if (c == 10) {
			addr = (addr & 0xffe0) + 32;
		} else {
			nes.PPUDATA = c;
			addr += 1;
		}
		if (c == 10 || addr >= 0x23c0) {
			if (addr >= 0x23c0) {
				addr = 0x2000;   // 画面の下まで来たら上に戻る (属性の表に書かない)
			}
			nes.PPUADDR = (addr >> 8) as u8;
			nes.PPUADDR = addr as u8;
		}
	}
}

// 終端 0 の文字列を書く
public function write_z(p:*const u8):void
{
	var n:u16 = 0;
	while (p[n] != 0) {
		n += 1;
	}
	write(@slice(p, n));
}

// s の中の最初の 0 まで (無ければ全部) 出す (u8 の配列を文字列として出すとき)
public function write_z_in(s:[:u16]const u8):void
{
	var n:u16 = 0;
	while (n < @len(s) && s[n] != 0) {
		n += 1;
	}
	write(s[..n]);
}

// 改行する
public function newline():void
{
	write("\n");
}

// 画面を出して止まる (NES には終わりが無い)。exit_code / exited をテストのランナーが読む
public function exit(code:u8):void
{
	exit_code = code;
	exited = 1;
	DEBUG_EXIT = code;
	nes.PPUSCROLL = 0;
	nes.PPUSCROLL = 0;
	nes.PPUCTRL = 0;
	nes.PPUMASK = 0b00001010;   // 背景を出す (左端の 8 ドットも)
	while (true) {
	}
}
