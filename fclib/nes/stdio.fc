#fc 3
/*
 * NES用の定義ファイル
 */

@(bank: -1);

public use * from nes;
@include("stdio.asm");

public var vsync_flag:u8;
public var ppu_addr:u16;
public var print_addr:u16;

public function wait_vsync():void @(abi: "frame");
public function print(str:*const u8):void @(abi: "frame");
public function ppu_put(addr:u16, data:*const u8, size:u8):void @(abi: "frame");

const HEX = "0123456789ABCDEF";

// printf の整数 (16 進 4 桁)
public function print_int16(n:u16):void
{
	var buf:[5]u8;
	buf[0] = HEX[(n >> 12) as u8];
	buf[1] = HEX[((n >> 8) as u8) & 15];
	buf[2] = HEX[((n >> 4) as u8) & 15];
	buf[3] = HEX[(n as u8) & 15];
	buf[4] = 0;
	print(&buf[0]);
}

// printf の符号付きの整数 (負なら '-' を付ける)
public function print_sint16(n:i16):void
{
	if (n < 0) {
		print("-");
		print_int16(@bitcast(u16, 0 - n));
	} else {
		print_int16(@bitcast(u16, n));
	}
}

// printf の slice (長さの分だけ。途中の 0 も終端にしない)
public function print_slice(s:[]const u8):void
{
	var buf:[2]u8;
	buf[1] = 0;
	for (var i:u8 = 0; i < @len(s); i += 1) {
		buf[0] = s[i];
		print(&buf[0]);
	}
}

public function puts(str:*const u8):void
{
	printf(str, "\n");
}

public function exit(code:u8):void
{
	printf('exit(', code, ")\n");
	PPUCTRL = 0b11001000;
	while (1) {
		wait_vsync();
		PPUSCROLL = 0;
		PPUSCROLL = 0;
		PPUCTRL = 0b11001000;
		PPUMASK = 0b00001010;
	}
}

public function init():void
{
	vsync_flag = 0xfd;
	const pallet = [15, 61, 16, 48, 0, 17, 33, 49, 0, 18, 34, 50, 0, 19, 35, 51];
	ppu_put(0x3f00, pallet, 16);
	print_addr = 0x2000;
}

public function interrupt():void @(abi: "stack", symbol: '_interrupt');
public function interrupt_irq():void @(abi: "stack", symbol: '_interrupt_irq');
