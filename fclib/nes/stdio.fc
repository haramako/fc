#fc 3
/*
 * NES用の定義ファイル
 */

@(bank: -1);

public use * from nes;
@include("stdio.asm");

public var vsync_flag:u8;
public var ppu_addr:u16;
public var print_addr:u16;

public function print_int16(n:u16):void;
public function wait_vsync():void;
public function print(str:*const u8):void @(fastcall);
public function ppu_put(addr:u16, data:*const u8, size:u8):void @(fastcall);

public function puts(str:*const u8):void
{
	printf(str, "\n");
}

public function exit(code:u8):void
{
	printf('exit(', code, ")\n");
	PPU_CTRL1 = 0b11001000;
	while (1) {
		wait_vsync();
		PPU_SCROLL = 0;
		PPU_SCROLL = 0;
		PPU_CTRL1 = 0b11001000;
		PPU_CTRL2 = 0b00001010;
	}
}

public function init():void
{
	vsync_flag = 0xfd;
	const pallet = [15, 61, 16, 48, 0, 17, 33, 49, 0, 18, 34, 50, 0, 19, 35, 51];
	ppu_put(0x3f00, pallet, 16);
	print_addr = 0x2000;
}

public function interrupt():void @(symbol: '_interrupt');
public function interrupt_irq():void @(symbol: '_interrupt_irq');
