#fc 3
@(bank: -1);

@include("mem.asm");

public function set(p:*u8, c:u8, size:u8):void @(fastcall);
public function zero(p:*u8, size:u8):void;
public function copy(_to:*u8, _from:*const u8, size:u16):void;
public function compare(p1:*const u8, p2:*const u8, size:u8):u8;

public function strlen(str:*const u8):u8 @(fastcall)
{
	var n = 0;
	while (str[n]) {
		n += 1;
	}
	return n;
}

public function strcpy(to:*u8, str:*const u8):u8 @(fastcall)
{
	var i = 0;
	while (1) {
		var c = str[i];
		to[i] = c;
		if (!c) {
			return i;
		}
		i += 1;
	}
}
