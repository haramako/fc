#fc 4
// デバッグ出力 (emu: fcc の内蔵のエミュレータが端末に出す。番地 $fff0〜$ffff でやり取りする)。printf / @assert / sys.panic の出力先。
@(bank: -1);

var EMU_ADDR:*const u8 @(address: 0xfff0);
var EMU_DATA:u16 @(address: 0xfff2);
var EMU_PRINT:u8 @(address: 0xfffe);
var EMU_EXIT:u8 @(address: 0xffff);

// 何もしない (NES の console と同じ呼び方にするため)
public function init():void {}

// s をそのまま出す (途中の 0 も)
public function write(s:[:u16]const u8):void
{
	EMU_ADDR = @ptr(s);
	EMU_DATA = @len(s);
	EMU_PRINT = 6;
}

// 終端 0 の文字列を出す
public function write_z(p:*const u8):void
{
	EMU_ADDR = p;
	EMU_PRINT = 1;
}

// s の中の最初の 0 まで (無ければ全部) 出す (u8 の配列を文字列として出すとき)
public function write_z_in(s:[:u16]const u8):void
{
	var n:u16 = 0;
	while (n < @len(s) && s[n] != 0) {
		n += 1;
	}
	write(s[..n]);
}

// 改行する
public function newline():void
{
	write("\n");
}

// プログラムを終える (code が終了コード)
public function exit(code:u8):void
{
	EMU_EXIT = code;
}

// ベンチマーク区間の始まり。bench_start から bench_end までのサイクル数をエミュレータが合計する
public function bench_start():void
{
	EMU_PRINT = 4;
}

// ベンチマーク区間の終わり
public function bench_end():void
{
	EMU_PRINT = 5;
}
