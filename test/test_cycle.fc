#fc 2
// golden と ROM を比べるので静的フレームの RAM の予約を固定する (書かなければ使う分だけ取り、使う量が変わると変数の番地がずれる)
options(static_ram: 512);
use * from unittest;

use cycle_use;
public var cycle_var:int;

include("character.chr");

function test_cycle_use():void
{
	cycle_var = cycle_use.CYCLE_CONST;
	assert_equal(cycle_use.hoge(), 99, "cycle use");
}

function main():void
{
	unittest_run_tests();
}
