//@can't init global variable
var a:int = 1; //! col=1

//@parse error
hoge fuga //! col=6

//@not compatible
const a:int = [1]; //! col=1

//@not compatible
function hoge():void
{
	var a:int = [1]; //! col=2
}

//@cannot define const without value
function hoge():void
{
	const a:int; //! col=2
}

//@not found
use unknown; //! col=1

//@can't return
function hoge():void { return 1; } //! col=24

//@ca65 returns 1
// options(symbol:) が無いと main から届かず出力されない (使われない関数の asm は ca65 に渡らない)
function hoge():void options(symbol: "_hoge_asm") {
	asm( "INVALID ASM" );
}

//@div by 0
function hoge():void {
	var i1 = 1;
	var i = i1 / 0; //! col=10
}

//@div by 0
function hoge():void {
	var i1 = 1;
	var i = i1 % 0; //! col=10
}


//@counter2 not found \(did you mean counter\?\)
var counter:int;
function hoge():void {
	counter2 = 1; //! col=2
}

//@parse error: unexpected `\}`
function hoge():void {
	var a = 1 +
} //! col=1

//@cannot dereference `a` \(type uint8 is not a pointer\)
function hoge():void {
	var a:int;
	*a = 1; //! col=2
}

//@`f` expects 1 argument\(s\) but 2 given
function f(a:int):void {}
function hoge():void {
	f(1, 2); //! col=2
}
